// Wonderous, in the Splash DSL.
//
// The third arm. The same app exists twice already -- hand-written Rust calling
// the ArkUI NDK, and ArkTS building the same widgets through typeNode -- and
// both of those describe the interface in a general-purpose language. This one
// describes it as data, evaluated on device by the Splash VM, and Rust turns
// what comes back into ArkUI nodes.
//
// The host binds these before evaluating:
//   screen, wonder, tab, page   where the app is
//   W, H                        the content area, in vp
//   the current wonder's fields, and whatever the screen needs
//
// Everything below -- the layout arithmetic, the per-screen dispatch, the
// loops that lay out tab bars and page dots -- is evaluated here, not in Rust.

// ---- palette ------------------------------------------------------------
// Hex literals evaluate to 0 in this VM, which would render everything
// transparent. Compose the ARGB word arithmetically instead.
fn argb(a, r, g, b) { return ((a * 256 + r) * 256 + g) * 256 + b }

let SHEET       = argb(255, 248, 236, 229)
let GREY_STRONG = argb(255,  39,  38,  37)
let ACCENT      = argb(255, 228, 147,  93)
let SCRIM       = argb(204,  39,  38,  37)
let DIM         = argb(204, 248, 236, 229)
let FAINT       = argb( 89, 248, 236, 229)
let CLEAR       = argb(  0,   0,   0,   0)

let DISPLAY  = "YesevaOne"
let SERIF_UI = "TenorSans"
let BODY     = "Raleway"

// ---- tap ids, matched to the Rust arm so the host dispatch is shared -----
let T_INTRO_NEXT  = 7300
let T_INTRO_ENTER = 7301
let T_MENU        = 7103
let T_PREV        = 7101
let T_NEXT        = 7102
let T_DETAILS     = 7104
let T_TAB         = 7200
let T_HOME        = 7210
let T_MENU_CLOSE  = 7310
let T_MENU_BASE   = 7320
let T_CLOSE       = 7340
let T_COLLECTION  = 7341
let T_TIMELINE    = 7342
let T_ART_PREV    = 7370
let T_ART_NEXT    = 7371
let T_BROWSE      = 7372
let T_ART_OPEN    = 7373
let T_PHOTO_OPEN  = 7375
let T_VIEWER_CLOSE = 7450
let T_VIEWER_PREV = 7451
let T_VIEWER_NEXT = 7452
let T_COLLECT     = 7460
let T_FOUND_CLOSE = 7490
let T_VIDEO       = 7454
let T_MAPS        = 7453
let T_HOME_SWIPE  = 7150
let T_SCROLLED    = 7160
let T_PHOTO_SWIPE = 7170
let T_VIEWER_SWIPE = 7180

// ---- helpers ------------------------------------------------------------
fn at(node, x, y) {
  node.x = x
  node.y = y
  return node
}

fn centred(s, size, color, font, w, h) {
  return {t: "text", text: s, size: size, color: color, font: font,
          w: w, h: h, talign: 1}
}

// A tap target: an invisible cell the host maps back to an id.
//
// One step of alpha rather than none. A fully transparent node is not a hit
// target in ArkUI, so a cell with no background never receives the tap even
// though the id is attached to it.
fn hit(x, y, w, h, id) {
  return at({t: "stack", w: w, h: h, bg: argb(1, 0, 0, 0), tap: id}, x, y)
}

// The same, but the node also reports drags. A gesture has to be measured on
// the node that receives it, so the cells that cover the screen carry it.
fn hit_swipe(x, y, w, h, id, base) {
  return at({t: "stack", w: w, h: h, bg: argb(1, 0, 0, 0), tap: id,
             swipe: base}, x, y)
}

// ---- intro --------------------------------------------------------------
// `onboarding_screen.dart`: a photograph over the top half, the wordmark, a
// title and a line of body copy, page dots, and one button that advances.
fn intro_screen() {
  let ph = H * 0.52
  let kids = [
    at({t: "image", src: intro_photo, w: W, h: ph, fit: 1}, 0, 0),
    at({t: "column", w: W, h: ph * 0.45, bg: SCRIM}, 0, ph * 0.55),
    at(centred("WONDEROUS", 13, ACCENT, SERIF_UI, W, 26), 0, H * 0.60),
    at(centred(intro_title, 32, SHEET, DISPLAY, W - 60, 48), 30, H * 0.65),
    at(centred(intro_body, 15, DIM, BODY, W - 80, 76), 40, H * 0.72),
  ]

  // Page dots. Three of them, the current one solid.
  let d = 7
  let gap = 11
  let total = intro_count * d + (intro_count - 1) * gap
  let dots = []
  let i = 0
  while i < intro_count {
    let fill = FAINT
    if i == page { fill = SHEET }
    dots.push({t: "column", w: d, h: d, bg: fill, radius: d / 2,
               margin: gap / 2})
    i = i + 1
  }
  kids.push(at({t: "row", w: W, h: 24, bg: CLEAR, c: dots,
                pad: 8, padx: (W - total) / 2}, 0, H * 0.84))

  // The button, and the tap cell over it.
  let last = page + 1 == intro_count
  let label = "NEXT"
  let id = T_INTRO_NEXT
  if last {
    label = "ENTER"
    id = T_INTRO_ENTER
  }
  kids.push(at({t: "column", w: W * 0.5, h: 52, bg: ACCENT, radius: 26,
                c: [{t: "text", text: label, size: 14, color: GREY_STRONG,
                     font: SERIF_UI, w: W * 0.5, h: 52, talign: 1, pad: 18}]},
               W * 0.25, H * 0.89))
  kids.push(hit(W * 0.25, H * 0.89, W * 0.5, 52, id))

  return {t: "stack", w: W, h: H, bg: GREY_STRONG, align: 0, c: kids}
}


// ---- home ---------------------------------------------------------------
// `home_screen.dart`: the wonder itself, full bleed, with its name across the
// lower third. The illustration is layered -- background pieces, the wonder,
// then the foreground fronds that overhang the title -- and every layer is
// placed here from its own anchor and fractional offsets.
fn place(pc) {
  let ph = H * pc[2]
  if ph < pc[3] { ph = pc[3] }
  let pw = ph * pc[1]
  let anchor = pc[4]
  // Anchor: 0 centre, 1 top-left, 2 top-centre, 3 top-right,
  //         4 bottom-left, 5 bottom-centre, 6 bottom-right.
  let ax = 0
  let ay = 0
  if anchor == 0 { ax = (W - pw) / 2  ay = (H - ph) / 2 }
  if anchor == 2 { ax = (W - pw) / 2 }
  if anchor == 3 { ax = W - pw }
  if anchor == 5 { ax = (W - pw) / 2  ay = H - ph }
  if anchor == 6 { ax = W - pw        ay = H - ph }
  if anchor == 4 { ay = H - ph }
  return at({t: "image", src: pc[0], w: pw, h: ph, fit: 0},
            ax + pc[5] * pw + pc[7], ay + pc[6] * ph + pc[8])
}

fn illustration() {
  let layers = [at({t: "image", src: w_texture, w: W, h: H, fit: 1}, 0, 0)]
  let i = 0
  while i < pieces.len() {
    if pieces[i][9] == 0 { layers.push(place(pieces[i])) }
    i = i + 1
  }
  return layers
}

fn foreground() {
  let layers = []
  let i = 0
  while i < pieces.len() {
    if pieces[i][9] == 1 { layers.push(place(pieces[i])) }
    i = i + 1
  }
  return layers
}

fn home_screen() {
  let kids = illustration()

  // Three clouds drifting across the scene, from the wonder's own seed.
  //
  // `drift` hands the node to ArkUI, which interpolates its translate at the
  // display's rate. The alternative -- recomputing a position from a clock and
  // re-describing the screen -- caps out around ten frames a second here,
  // because rebuilding the illustration recreates its image nodes faster than
  // they decode. Wonderous gives each wonder its own seed so no two drift
  // alike.
  let ci = 0
  while ci < 3 {
    let seed = cloud_seed + ci * 37
    let cy = H * 0.08 + (seed % 23) * H * 0.012
    let cw2 = W * 0.5 + (seed % 7) * 18
    let span = W + cw2
    // Seconds to cross, so a wider cloud is not also a faster one.
    let secs = 26 + seed % 13
    kids.push(at({t: "column", w: cw2, h: cw2 * 0.22,
                  bg: argb(28, 248, 236, 229), radius: cw2 * 0.11,
                  drift: [span, 0, secs * 1000]}, 0 - cw2, cy))
    ci = ci + 1
  }

  // The fronds and dunes that overhang the scene go on before the name: the
  // app draws the whole illustration first and lays the masthead over all of
  // it. Pushed after, they bury the title -- which is exactly what they did.
  let f = foreground()
  let k = 0
  while k < f.len() { kids.push(f[k])  k = k + 1 }

  // The name. One line when there is no second word, otherwise the small
  // italic article rides beside the second word rather than above it -- the
  // detail that makes the name read as a masthead instead of two stacked words.
  let size = 56
  let line_h = size * 1.16
  let block_h = line_h
  if w_line2 != "" { block_h = line_h * 2 }
  let y = H - block_h - H * 0.115
  if y < H * 0.5 { y = H * 0.5 }

  kids.push(at(centred(w_line1, size, SHEET, DISPLAY, W, line_h), 0, y))
  if w_line2 != "" {
    if w_article == "" {
      // No article, so the word is simply centred in the frame. Laying it out
      // as a row would need the row's own justification, which the DSL has no
      // key for -- and left-justified is what that looked like.
      kids.push(at(centred(w_line2, size, SHEET, DISPLAY, W, line_h), 0, y + line_h))
    } else {
      // The article rides beside the second word in a much smaller italic,
      // sitting on its baseline. Centring the pair is what puts "the" against
      // the R of Redeemer rather than parking it at the margin.
      let word_w = w_em2 * size + size * 0.25
      let art_w = size * 0.9
      let group = art_w + word_w
      let line = [
        {t: "text", text: w_article, size: size * 0.40, color: SHEET,
         font: BODY, w: art_w, h: line_h, talign: 2, pad: line_h * 0.36},
        centred(w_line2, size, SHEET, DISPLAY, word_w, line_h),
      ]
      kids.push(at({t: "row", w: group, h: line_h, bg: CLEAR, c: line},
                   (W - group) / 2, y + line_h))
    }
  }

  // Which of the eight is showing.
  let d = 7
  let gap = 10
  let total = w_count * d + (w_count - 1) * gap
  let dots = []
  let i = 0
  while i < w_count {
    let fill = FAINT
    if i == wonder { fill = SHEET }
    dots.push({t: "column", w: d, h: d, bg: fill, radius: d / 2, margin: gap / 2})
    i = i + 1
  }
  kids.push(at({t: "row", w: W, h: 36, bg: CLEAR, c: dots,
                pad: 14, padx: (W - total) / 2}, 0, H * 0.90))

  // The menu disc, top left.
  kids.push(at({t: "stack", w: 44, h: 44, bg: argb(179, 39, 38, 37), radius: 22,
                c: [{t: "image", src: "resource://RAWFILE/wonders/_common/icons/icon-menu.png",
                     w: 22, h: 22, fit: 0}]}, 20, H * 0.055))

  // Tap targets: the menu, a third of the frame each side to change wonder,
  // and the bottom band to open the details.
  kids.push(hit(12, H * 0.045, 62, 62, T_MENU))
  kids.push(hit_swipe(0, H * 0.14, W * 0.35, H * 0.6, T_PREV, T_HOME_SWIPE))
  kids.push(hit_swipe(W * 0.35, H * 0.14, W * 0.3, H * 0.6, 0, T_HOME_SWIPE))
  kids.push(hit_swipe(W * 0.65, H * 0.14, W * 0.35, H * 0.6, T_NEXT, T_HOME_SWIPE))
  kids.push(hit(0, H * 0.80, W, H * 0.17, T_DETAILS))

  return {t: "stack", w: W, h: H, bg: w_bg, align: 0, c: kids}
}


// ---- details ------------------------------------------------------------
// `wonder_details_screen.dart`: four tabs over one wonder -- the editorial,
// the photo wall, the artifacts, and the timeline -- with the tab bar pinned
// to the bottom in the wonder's own colour.
let BAR_H = 80

fn tab_bar() {
  let icons = ["icon-info.png", "icon-wallpaper.png", "icon-collection.png",
               "icon-timeline.png"]
  let d = 52
  let cell = (W - d - 20) / 4
  let kids = [
    // The wonder's own emblem, which returns to the home screen.
    at({t: "image", src: w_texture, w: d, h: d, fit: 1, radius: d / 2}, 10, 14)
  ]
  let i = 0
  while i < 4 {
    let tint = FAINT
    if i == tab { tint = SHEET }
    kids.push(at({t: "column", w: cell, h: BAR_H, bg: CLEAR,
                  c: [{t: "image", src: icon_base + icons[i], w: 26, h: 26,
                       fit: 0, margin: 4}]},
                 d + 20 + cell * i, 18))
    // The selected tab carries a short rule beneath it.
    if i == tab {
      kids.push(at({t: "column", w: 26, h: 2, bg: ACCENT},
                   d + 20 + cell * i + (cell - 26) / 2, 54))
    }
    i = i + 1
  }
  return {t: "stack", w: W, h: BAR_H, bg: w_bg, align: 0, c: kids}
}


// The illustration again, scaled into a band rather than the full frame. Same
// anchors and fractions; only the frame it is measured against changes.
fn place_in(pc, fw, fh) {
  let ph = fh * pc[2]
  if ph < pc[3] { ph = pc[3] }
  let pw = ph * pc[1]
  let anchor = pc[4]
  let ax = 0
  let ay = 0
  if anchor == 0 { ax = (fw - pw) / 2  ay = (fh - ph) / 2 }
  if anchor == 2 { ax = (fw - pw) / 2 }
  if anchor == 3 { ax = fw - pw }
  if anchor == 5 { ax = (fw - pw) / 2  ay = fh - ph }
  if anchor == 6 { ax = fw - pw        ay = fh - ph }
  if anchor == 4 { ay = fh - ph }
  return at({t: "image", src: pc[0], w: pw, h: ph, fit: 0},
            ax + pc[5] * pw + pc[7], ay + pc[6] * ph + pc[8])
}

fn hero_layers(hh) {
  let layers = [at({t: "image", src: w_texture, w: W, h: hh, fit: 1}, 0, 0)]
  let i = 0
  while i < pieces.len() {
    layers.push(place_in(pieces[i], W, hh))
    i = i + 1
  }
  return layers
}

// ---- tab 0: the editorial ----------------------------------------------
fn editorial_body(bh) {
  let cw = W - 56
  // A scroll's content column has to be told its own height. ArkUI will not
  // measure it from the children, and a column left at zero collapses -- the
  // article rendered as nothing but its header until this was accumulated.
  let total = 0
  let kids = []

  // The illustration heads the article, as the app's collapsing header does --
  // the layered scene, not the bare texture it is painted on.
  let hero = bh * 0.42
  // The hero rides up at half the reader's speed. `parallax` is a function of
  // where the scroll is, not of the clock, which is why drift cannot express
  // it -- the illustration has to be somewhere specific for a given offset.
  kids.push({t: "stack", w: W, h: hero, bg: w_fg, clip: 1, parallax: 0.5,
             c: hero_layers(hero)})
  total = total + hero

  kids.push({t: "text", text: "THE ANCIENT WONDER", size: 12, color: ACCENT,
             font: SERIF_UI, w: W, h: 30, talign: 1, margin: 10})
  total = total + 50

  kids.push({t: "text", text: w_title, size: 38, color: GREY_STRONG,
             font: DISPLAY, w: W, h: 56, talign: 1})
  total = total + 56

  kids.push({t: "text", text: e_sub, size: 14, color: argb(153, 39, 38, 37),
             font: BODY, w: W, h: 26, talign: 1})
  total = total + 26

  kids.push({t: "column", w: W, h: 26, bg: CLEAR})
  total = total + 26

  let i = 0
  while i < e_paras.len() {
    // Height from the text's own length: ArkUI cannot report a laid-out text
    // node's height, so a box sized by anything else clips or gaps.
    let lines = e_paras[i].len() / 34 + 1
    let ph = lines * 26 + 12
    kids.push({t: "text", text: e_paras[i], size: 16,
               color: argb(221, 39, 38, 37), font: BODY, w: cw, h: ph,
               margin: 14})
    total = total + ph + 28
    // The pull quote sits after the second paragraph, as it does in the app.
    if i == 1 {
      kids.push({t: "text", text: e_quote, size: 22, color: GREY_STRONG,
                 font: DISPLAY, w: cw, h: 110, talign: 1, margin: 16})
      kids.push({t: "text", text: e_author, size: 12, color: ACCENT,
                 font: SERIF_UI, w: cw, h: 28, talign: 1})
      total = total + 110 + 32 + 28
    }
    i = i + 1
  }
  // The film still and the location block, both of which open a fullscreen
  // web surface. Tapping rides on the row itself for the same reason the menu
  // rows do.
  kids.push({t: "stack", w: cw, h: cw * 0.56, bg: GREY_STRONG, tap: T_VIDEO,
             margin: 10,
             c: [{t: "text", text: "WATCH THE FILM", size: 12, color: SHEET,
                  font: SERIF_UI, w: cw, h: cw * 0.56, talign: 1,
                  pad: cw * 0.24}]})
  total = total + cw * 0.56 + 20

  kids.push({t: "text", text: "LOCATION", size: 13, color: ACCENT,
             font: SERIF_UI, w: W, h: 40, talign: 1, margin: 8,
             tap: T_MAPS})
  total = total + 56

  // The collectible the app hides in the article. A row rather than a cell
  // pinned over the scroll: pinned cells do not move when the article does,
  // which is why the first attempt never fired.
  kids.push({t: "stack", w: 48, h: 48, bg: argb(51, 248, 236, 229), radius: 24,
             margin: 10, tap: T_COLLECT + wonder * 3,
             c: [{t: "image", src: collectibles[wonder * 3][2], w: 26, h: 26,
                  fit: 0}]})
  total = total + 68

  kids.push({t: "column", w: W, h: 40, bg: CLEAR})
  total = total + 40

  // At least the viewport: a column shorter than the scroll leaves the page
  // colour showing above it, which read as a gap on every short tab.
  if total < bh { total = bh }
  return {t: "scroll", w: W, h: bh, tap: T_SCROLLED,
          c: [{t: "column", w: W, h: total, bg: SHEET, align: 1, c: kids}]}
}

// ---- tab 1: the photo wall ---------------------------------------------
// `photo_gallery.dart`: a 5x5 wall of twenty-five cells with one selected.
//
// The wall slides so the selected cell sits in the middle rather than the
// selection moving across a static grid, and everything except that cell is
// under a scrim -- `_AnimatedCutoutOverlay`, which ArkUI has no cut-out shape
// for, so it is the four rectangles the hole would leave behind. Swiping moves
// the selection; tapping the lit cell opens it full screen.
fn photos_body(bh) {
  let grid = 5
  let iw = W * 0.66
  let ih = bh * 0.5
  let pad = 24
  let sx = iw + pad
  let sy = ih + pad
  let ox = (W - iw) / 2
  let oy = (bh - ih) / 2
  let sel = photo_sel % (grid * grid)

  // All twenty-five are built, not just the nine that can be seen: a cell has
  // to exist to be slid into view.
  let kids = []
  let i = 0
  while i < grid * grid {
    let cx = ox + (i % grid) * sx - (sel % grid) * sx
    let cy = oy + (i / grid) * sy - (sel / grid) * sy
    let n = i % gallery_n
    let name = n + ""
    if n < 10 { name = "0" + n }
    kids.push(at({t: "image", src: gallery_base + name + ".jpg",
                  w: iw, h: ih, fit: 1}, cx, cy))
    i = i + 1
  }

  // The scrim, as the four rectangles around the lit cell.
  let dim = argb(179, 0, 0, 0)
  kids.push(at({t: "column", w: W, h: oy, bg: dim}, 0, 0))
  kids.push(at({t: "column", w: W, h: bh - oy - ih, bg: dim}, 0, oy + ih))
  kids.push(at({t: "column", w: ox, h: ih, bg: dim}, 0, oy))
  kids.push(at({t: "column", w: W - ox - iw, h: ih, bg: dim}, ox + iw, oy))

  // Where in the wall you are.
  kids.push(at({t: "text", text: sel + 1 + " / " + (grid * grid), size: 12,
                color: argb(153, 248, 236, 229), font: BODY, w: W, h: 20,
                talign: 1}, 0, bh - 34))

  // The lit cell opens; a drag anywhere moves the selection.
  return {t: "stack", w: W, h: bh, bg: w_bg, align: 0, clip: 1,
          swipe: T_PHOTO_SWIPE,
          c: [{t: "stack", w: W, h: bh, bg: CLEAR, align: 0, c: kids},
              at({t: "stack", w: iw, h: ih, bg: argb(1, 0, 0, 0),
                  tap: T_PHOTO_OPEN}, ox, oy)]}
}

// ---- tab 2: the artifacts ----------------------------------------------
// `artifact_carousel.dart`: the pieces as a carousel, not a list.
//
// The selected piece stands tall in a capsule frame; its neighbours are round
// and dropped progressively lower, so the row reads as an arc. Behind it, the
// piece's own photograph blown up and blurred under a black wash -- the screen
// takes its colour from the object on it rather than from the wonder -- and a
// very shallow pale dome across the middle, which is a 2000-wide disc pushed
// down by half its size.
fn artifacts_body(bh) {
  let n = artifacts.len()
  let sel = art_sel % n
  let bottom_h = bh / 2.75
  let item_h = bh - 200 - bottom_h
  if item_h < 250 { item_h = 250 }
  if item_h > 400 { item_h = 400 }
  let iw = item_h * 0.666
  let tall = iw * 1.5
  let ay = (bh - tall) / 2 - tall * 0.25
  let cx = (W - iw) / 2

  // The selected piece's own photograph, blown up and blurred.
  let kids = [
    at({t: "image", src: art_base + artifacts[sel][0] + ".jpg",
        w: W * 1.25, h: bh * 1.25, fit: 1}, 0 - W * 0.125, 0 - bh * 0.05),
    at({t: "column", w: W, h: bh, bg: argb(153, 0, 0, 0)}, 0, 0),
  ]

  // The dome: only the top corners rounded on a very tall box is the same
  // shape as a huge disc pushed off the bottom of the screen.
  let dome = 2000
  kids.push(at({t: "column", w: dome, h: dome, bg: argb(204, 248, 236, 229),
                radius: dome / 2}, (W - dome) / 2, bh * 0.5))

  // Furthest from the selection first, so the selected piece ends up on top.
  let d = 3
  while d >= 0 {
    let k = 0 - d
    while k <= d {
      if k * k == d * d {
        let i = (sel + k + n * 2) % n
        // How far each neighbour is dropped below the tall one.
        let drop = iw
        if d == 0 { drop = 0 }
        if d == 1 { drop = iw * 0.5 }
        if d == 2 { drop = iw * 0.825 }
        let ih = iw
        if k == 0 { ih = tall }
        let x = cx + k * iw
        let y = ay + (tall - ih) / 2 + drop
        let inset = iw * 0.1
        if k == 0 { inset = 8 }
        // `_DoubleBorderImage`: a capsule outlined in off-white with the piece
        // inset inside it, clipped to the same capsule.
        kids.push(at({t: "column", w: iw, h: ih, bg: CLEAR, radius: iw / 2,
                      border: 1, bordercolor: SHEET}, x, y))
        kids.push(at({t: "image", src: art_base + artifacts[i][0] + ".jpg",
                      w: iw - inset * 2, h: ih - inset * 2, fit: 1,
                      radius: (iw - inset * 2) / 2},
                     x + inset, y + inset))
      }
      k = k + 1
    }
    d = d - 1
  }

  // The piece's own caption, under the arc.
  let a = artifacts[sel]
  kids.push(at({t: "text", text: "ARTIFACTS", size: 13, color: ACCENT,
                font: SERIF_UI, w: W, h: 30, talign: 1}, 0, bh * 0.06))
  kids.push(at({t: "text", text: a[1], size: 21, color: GREY_STRONG,
                font: DISPLAY, w: W - 56, h: 72, talign: 1}, 28, bh * 0.66))
  kids.push(at({t: "text", text: a[2] + "  |  " + a[3], size: 12,
                color: argb(153, 39, 38, 37), font: BODY, w: W, h: 24,
                talign: 1}, 0, bh * 0.78))

  // Browse, and the sides that step through the arc.
  // The tap rides on the button itself rather than a cell positioned over it.
  // A separate cell has to be placed to agree with what is drawn, and when it
  // does not the button is simply dead -- the same failure the menu rows had
  // before they carried their own id.
  kids.push(at({t: "column", w: W * 0.72, h: 52, bg: GREY_STRONG, radius: 26,
                tap: T_BROWSE,
                c: [{t: "text", text: "BROWSE ALL", size: 12, color: SHEET,
                     font: SERIF_UI, w: W * 0.72, h: 52, talign: 1, pad: 18}]},
               W * 0.14, bh - 66))
  // A hit area larger than the button it sits under. The pill is 52 tall and
  // the thumb aiming at it is not that precise; a near-miss landing on nothing
  // reads as a dead button, which is exactly how this was reported.
  // Stepping the arc: the two side thirds and the tall piece in the middle.
  // These sit above the button, so they cannot swallow it.
  kids.push(hit(0, ay, cx, tall, T_ART_PREV))
  kids.push(hit(cx, ay, iw, tall, T_ART_OPEN))
  kids.push(hit(cx + iw, ay, W - cx - iw, tall, T_ART_NEXT))

  return {t: "stack", w: W, h: bh, bg: w_bg, align: 0, clip: 1, c: kids}
}

// ---- tab 3: the timeline ------------------------------------------------
fn events_body(bh) {
  let kids = [
    {t: "text", text: "TIMELINE", size: 12, color: ACCENT, font: SERIF_UI,
     w: W, h: 30, talign: 1, margin: 16},
  ]
  let total = 62
  let i = 0
  while i < events.len() {
    let ev = events[i]
    let year = ev[0] + ""
    if ev[0] < 0 { year = 0 - ev[0] + " BCE" }
    kids.push({t: "text", text: year, size: 15, color: ACCENT, font: SERIF_UI,
               w: W - 56, h: 28, margin: 6})
    let lines = ev[1].len() / 40 + 1
    kids.push({t: "text", text: ev[1], size: 14, color: argb(221, 248, 236, 229),
               font: BODY, w: W - 56, h: lines * 22 + 8})
    i = i + 1
  }
  kids.push({t: "column", w: W, h: 40, bg: CLEAR})
  if total < bh { total = bh }
  return {t: "scroll", w: W, h: bh, c: [{t: "column", w: W, h: total,
                                          bg: GREY_STRONG, align: 1, c: kids}]}
}

fn details_screen() {
  let bh = H - BAR_H
  let body = editorial_body(bh)
  if tab == 1 { body = photos_body(bh) }
  if tab == 2 { body = artifacts_body(bh) }
  if tab == 3 { body = events_body(bh) }

  let kids = [at(body, 0, 0), at(tab_bar(), 0, bh)]

  // The emblem returns home; the four cells switch tab.
  let d = 52
  let cell = (W - d - 20) / 4
  kids.push(hit(0, bh, d + 20, BAR_H, T_HOME))
  let i = 0
  while i < 4 {
    kids.push(hit(d + 20 + cell * i, bh, cell, BAR_H, T_TAB + i))
    i = i + 1
  }
  // What each tab opens: the wall opens a photograph, the artifacts open one
  // artifact and the browser, and the editorial hides a collectible.
  if tab == 2 {
    kids.push(hit(W * 0.2, bh * 0.25, W * 0.6, bh * 0.35, T_ART_OPEN))
    kids.push(hit(W * 0.14, bh - 66, W * 0.72, 52, T_BROWSE))
  }

  return {t: "stack", w: W, h: H, bg: w_bg, align: 0, c: kids}
}


// ---- a screen that is a list over the page colour ----------------------
// The menu, the collection and the timeline all share this frame: a full
// bleed panel, a title, a close disc top right, and a list.
fn sheet_screen(title, rows, total, close_id) {
  let head = 96
  let kids = [
    at({t: "text", text: title, size: 13, color: ACCENT, font: SERIF_UI,
        w: W, h: 30, talign: 1}, 0, H * 0.05),
    at({t: "scroll", w: W, h: H - head,
        c: [{t: "column", w: W, h: total, bg: GREY_STRONG, align: 1, c: rows}]},
       0, head),
    at({t: "stack", w: 46, h: 46, bg: argb(89, 0, 0, 0), radius: 23,
        c: [{t: "image", src: icon_base + "icon-close.png", w: 20, h: 20,
             fit: 0}]}, W - 76, H * 0.025),
    hit(W - 76, H * 0.02, 66, 66, close_id),
  ]
  return {t: "stack", w: W, h: H, bg: GREY_STRONG, align: 0, c: kids}
}

// ---- menu ---------------------------------------------------------------
// `wonders_menu.dart`: the eight, then the two collections.
fn menu_screen() {
  let rows = []
  let total = 0
  let rh = 56
  let i = 0
  while i < all_wonders.len() {
    let tint = argb(153, 248, 236, 229)
    if i == wonder { tint = SHEET }
    // The tap rides on the row itself. Absolutely-positioned cells over a
    // scrolling list drift the moment the list scrolls or the estimated
    // content height is off by a row -- and it was.
    rows.push({t: "text", text: all_wonders[i][0], size: 22, color: tint,
               font: DISPLAY, w: W, h: rh, talign: 1,
               tap: T_MENU_BASE + i})
    total = total + rh
    i = i + 1
  }
  rows.push({t: "column", w: W * 0.5, h: 1, bg: argb(60, 248, 236, 229),
             margin: 12})
  total = total + 25
  rows.push({t: "text", text: "COLLECTION", size: 13, color: ACCENT,
             font: SERIF_UI, w: W, h: rh, talign: 1, tap: T_COLLECTION})
  rows.push({t: "text", text: "TIMELINE", size: 13, color: ACCENT,
             font: SERIF_UI, w: W, h: rh, talign: 1, tap: T_TIMELINE})
  total = total + rh * 2

  return sheet_screen("WONDEROUS", rows, total, T_MENU_CLOSE)
}

// ---- collection ---------------------------------------------------------
// `collection_screen.dart`: the twenty-four, the found ones lit.
fn collection_screen() {
  let rows = []
  let total = 0
  let cols = 4
  let cell = W / cols
  let i = 0
  while i < collectibles.len() {
    let row_kids = []
    let k = 0
    while k < cols {
      let n = i + k
      if n < collectibles.len() {
        let c = collectibles[n]
        // A lost one is drawn as a dim disc; a found one shows its piece.
        let disc = argb(30, 248, 236, 229)
        if c[3] == 1 { disc = argb(60, 228, 147, 93) }
        row_kids.push({t: "stack", w: cell - 10, h: cell - 10, bg: disc,
                       radius: (cell - 10) / 2, margin: 5,
                       c: [{t: "image", src: c[2], w: cell * 0.5,
                            h: cell * 0.5, fit: 0}]})
      }
      k = k + 1
    }
    rows.push({t: "row", w: W, h: cell, bg: CLEAR, c: row_kids})
    total = total + cell
    i = i + cols
  }
  rows.push({t: "text", text: found_n + " of " + collectibles.len() + " found",
             size: 13, color: argb(153, 248, 236, 229), font: BODY,
             w: W, h: 40, talign: 1, margin: 12})
  total = total + 64
  return sheet_screen("COLLECTION", rows, total, T_CLOSE)
}

// ---- timeline -----------------------------------------------------------
// `timeline_screen.dart`: not the wonder's own events, but all eight on one
// scale, so you can see which overlapped. A row each -- portrait, name, and a
// bar spanning that wonder's years across a shared track.
fn year_label(y) {
  if y < 0 { return 0 - y + " BCE" }
  return y + " CE"
}

fn timeline_screen() {
  let span = era_hi - era_lo
  if span < 1 { span = 1 }
  let top = H * 0.16
  let row_h = 68
  let track_x = 96
  let track_w = W - track_x - 24

  let kids = [
    at({t: "text", text: "TIMELINE", size: 13, color: ACCENT, font: SERIF_UI,
        w: W, h: 26, talign: 1}, 0, H * 0.055),
    at({t: "text", text: year_label(era_lo) + "  —  " + year_label(era_hi),
        size: 13, color: argb(153, 248, 236, 229), font: BODY, w: W, h: 24,
        talign: 1}, 0, H * 0.095),
  ]

  let i = 0
  while i < spans.len() {
    let sp = spans[i]
    let y = top + row_h * i
    let x0 = track_x + (sp[1] - era_lo) * track_w / span
    let x1 = track_x + (sp[2] - era_lo) * track_w / span
    let bar_w = x1 - x0
    if bar_w < 3 { bar_w = 3 }
    let tint = argb(153, 248, 236, 229)
    let bar = argb(120, 228, 147, 93)
    if i == wonder { tint = SHEET  bar = ACCENT }

    kids.push(at({t: "image", src: sp[3], w: 34, h: 34, fit: 1, radius: 17},
                 20, y + 6))
    kids.push(at({t: "text", text: sp[0], size: 11, color: tint, font: SERIF_UI,
                  w: track_x - 26, h: 18}, 20, y + 44))
    // The track it sits on, then its own span over it.
    kids.push(at({t: "column", w: track_w, h: 2,
                  bg: argb(40, 248, 236, 229)}, track_x, y + 22))
    kids.push(at({t: "column", w: bar_w, h: 6, bg: bar, radius: 3}, x0, y + 20))
    kids.push(at({t: "text", text: year_label(sp[1]), size: 10,
                  color: argb(120, 248, 236, 229), font: BODY, w: 90, h: 16},
                 x0, y + 32))
    i = i + 1
  }

  kids.push(at({t: "stack", w: 46, h: 46, bg: argb(89, 0, 0, 0), radius: 23,
                c: [{t: "image", src: icon_base + "icon-close.png", w: 20,
                     h: 20, fit: 0}]}, W - 76, H * 0.025))
  kids.push(hit(W - 76, H * 0.02, 66, 66, T_CLOSE))

  return {t: "stack", w: W, h: H, bg: GREY_STRONG, align: 0, c: kids}
}

// ---- search -------------------------------------------------------------
// `artifact_search_screen.dart`: a field, a row of suggestion chips drawn from
// the wonder's own list, a time-range pill, and a grid of results -- the
// artifacts that fall inside the wonder's era. Not a list of four titles,
// which is what stood here.
fn search_screen() {
  let head = 96
  let kids = [
    at({t: "text", text: "BROWSE ARTIFACTS", size: 13, color: ACCENT,
        font: SERIF_UI, w: W, h: 30, talign: 1}, 0, H * 0.05),
  ]

  // The field.
  kids.push(at({t: "column", w: W - 48, h: 46, bg: argb(30, 248, 236, 229),
                radius: 23,
                c: [{t: "text", text: "Search the collection", size: 14,
                     color: argb(120, 248, 236, 229), font: BODY,
                     w: W - 48, h: 46, talign: 1, pad: 14}]}, 24, head))

  // Suggestion chips, the app's own words for this wonder.
  let cx = 24
  let cy = head + 60
  let i = 0
  while i < suggestions.len() {
    let cw2 = suggestions[i].len() * 8 + 28
    if cx + cw2 > W - 24 { cx = 24  cy = cy + 40 }
    kids.push(at({t: "column", w: cw2, h: 32, bg: argb(26, 248, 236, 229),
                  radius: 16,
                  c: [{t: "text", text: suggestions[i], size: 12, color: SHEET,
                       font: BODY, w: cw2, h: 32, talign: 1, pad: 9}]}, cx, cy))
    cx = cx + cw2 + 8
    i = i + 1
  }

  // The range pill.
  let py = cy + 48
  kids.push(at({t: "column", w: W - 48, h: 40, bg: argb(20, 248, 236, 229),
                radius: 20,
                c: [{t: "text",
                     text: year_label(era_from) + "  —  " + year_label(era_to),
                     size: 12, color: argb(180, 248, 236, 229), font: SERIF_UI,
                     w: W - 48, h: 40, talign: 1, pad: 12}]}, 24, py))

  // The results, as a grid of thumbnails from the Met.
  let gy = py + 56
  let cols = 3
  let cell = (W - 48 - 16) / cols
  let rows = []
  let total = 0
  let k = 0
  while k < results.len() {
    let row_kids = []
    let c = 0
    while c < cols {
      let n = k + c
      if n < results.len() {
        row_kids.push({t: "image", src: results[n][0], w: cell, h: cell * 1.2,
                       fit: 1, radius: 4, margin: 4})
      }
      c = c + 1
    }
    rows.push({t: "row", w: W - 48, h: cell * 1.2 + 8, bg: CLEAR, c: row_kids})
    total = total + cell * 1.2 + 8
    k = k + cols
  }
  kids.push(at({t: "scroll", w: W - 48, h: H - gy - 16,
                c: [{t: "column", w: W - 48, h: total, bg: CLEAR, c: rows}]},
               24, gy))

  kids.push(at({t: "stack", w: 46, h: 46, bg: argb(89, 0, 0, 0), radius: 23,
                c: [{t: "image", src: icon_base + "icon-close.png", w: 20,
                     h: 20, fit: 0}]}, W - 76, H * 0.025))
  kids.push(hit(W - 76, H * 0.02, 66, 66, T_VIEWER_CLOSE))

  return {t: "stack", w: W, h: H, bg: GREY_STRONG, align: 0, c: kids}
}

// ---- one artifact -------------------------------------------------------
fn artifact_screen() {
  let a = artifacts[art_sel]
  let kids = [
    at({t: "text", text: a[1], size: 26, color: SHEET, font: DISPLAY,
        w: W - 56, h: 90, talign: 1}, 28, H * 0.62),
    at({t: "text", text: a[2], size: 13, color: ACCENT, font: SERIF_UI,
        w: W, h: 26, talign: 1}, 0, H * 0.75),
    at({t: "text", text: a[3], size: 13, color: argb(153, 248, 236, 229),
        font: BODY, w: W, h: 26, talign: 1}, 0, H * 0.79),
    at({t: "stack", w: 46, h: 46, bg: argb(89, 0, 0, 0), radius: 23,
        c: [{t: "image", src: icon_base + "icon-close.png", w: 20, h: 20,
             fit: 0}]}, 24, H * 0.03),
    hit(14, H * 0.02, 66, 66, T_VIEWER_CLOSE),
  ]
  return {t: "stack", w: W, h: H, bg: GREY_STRONG, align: 0, c: kids}
}

// ---- the fullscreen photograph -----------------------------------------
fn photo_screen() {
  let name = photo_sel + ""
  if photo_sel < 10 { name = "0" + photo_sel }
  let d = 52
  let gap = 16
  let y = H - d - 40
  let x0 = (W - d * 2 - gap) / 2
  let kids = [
    at({t: "image", src: gallery_base + name + ".jpg", w: W, h: H * 0.72,
        fit: 0}, 0, H * 0.14),
    at({t: "text", text: photo_sel + 1 + " / " + gallery_n, size: 12,
        color: argb(153, 248, 236, 229), font: BODY, w: W, h: 20, talign: 1},
       0, y - 28),
    at({t: "stack", w: d, h: d, bg: argb(51, 248, 236, 229), radius: d / 2,
        c: [{t: "image", src: icon_base + "icon-prev.png", w: 20, h: 20,
             fit: 0}]}, x0, y),
    at({t: "stack", w: d, h: d, bg: argb(51, 248, 236, 229), radius: d / 2,
        c: [{t: "image", src: icon_base + "icon-next-large.png", w: 20, h: 20,
             fit: 0}]}, x0 + d + gap, y),
    at({t: "stack", w: 46, h: 46, bg: argb(89, 0, 0, 0), radius: 23,
        c: [{t: "image", src: icon_base + "icon-close.png", w: 20, h: 20,
             fit: 0}]}, 24, H * 0.03),
    hit(14, H * 0.02, 66, 66, T_VIEWER_CLOSE),
    hit(x0, y, d, d, T_VIEWER_PREV),
    hit(x0 + d + gap, y, d, d, T_VIEWER_NEXT),
  ]
  // Swiping moves between photographs, as the app does; the two circles
  // are the same thing for a thumb that would rather tap.
  return {t: "stack", w: W, h: H, bg: argb(255, 0, 0, 0), align: 0,
          swipe: T_VIEWER_SWIPE, c: kids}
}

// ---- the collectible you just found -------------------------------------
fn found_screen() {
  let c = collectibles[art_sel]
  let kids = [
    at({t: "image", src: c[2], w: W * 0.4, h: W * 0.4, fit: 0},
       W * 0.3, H * 0.2),
    at({t: "text", text: "COLLECTIBLE FOUND", size: 12, color: ACCENT,
        font: SERIF_UI, w: W, h: 22, talign: 1}, 0, H * 0.62),
    at({t: "text", text: c[0], size: 26, color: SHEET, font: DISPLAY,
        w: W - 56, h: 72, talign: 1}, 28, H * 0.66),
    at({t: "text", text: found_n + " of " + collectibles.len() + " found",
        size: 13, color: argb(153, 248, 236, 229), font: BODY, w: W, h: 22,
        talign: 1}, 0, H * 0.78),
    at({t: "column", w: W * 0.5, h: 48, bg: GREY_STRONG, radius: 4,
        c: [{t: "text", text: "CONTINUE", size: 12, color: SHEET,
             font: SERIF_UI, w: W * 0.5, h: 48, talign: 1, pad: 17}]},
       W * 0.25, H - 96),
    hit(W * 0.25, H - 96, W * 0.5, 48, T_FOUND_CLOSE),
  ]
  return {t: "stack", w: W, h: H, bg: argb(242, 30, 27, 24), align: 0, c: kids}
}

// ---- the web viewers ----------------------------------------------------
// The film and the map are both a composited ArkWeb surface with this chrome
// over it. `web` reserves the rectangle; the host puts the surface there.
fn web_screen(src, caption) {
  let side = W
  let top = (H - side) / 2
  let kids = [
    {t: "web", src: src, x: 0, y: top, w: side, h: side},
    at({t: "stack", w: 46, h: 46, bg: argb(89, 0, 0, 0), radius: 23,
        c: [{t: "image", src: icon_base + "icon-close.png", w: 20, h: 20,
             fit: 0}]}, 24, H * 0.03),
    hit(14, H * 0.02, 66, 66, T_VIEWER_CLOSE),
  ]
  if caption != "" {
    kids.push(at({t: "text", text: caption, size: 13, color: SHEET,
                  font: SERIF_UI, w: W, h: 24, talign: 1}, 0, H - 44))
  }
  return {t: "stack", w: W, h: H, bg: argb(255, 30, 27, 24), align: 0, c: kids}
}

// ---- dispatch -----------------------------------------------------------
if screen == 0 { intro_screen() }
else { if screen == 1 { home_screen() }
else { if screen == 2 { details_screen() }
else { if screen == 3 { menu_screen() }
else { if screen == 4 { collection_screen() }
else { if screen == 5 { timeline_screen() }
else { if screen == 6 { search_screen() }
else { if screen == 7 { artifact_screen() }
else { if screen == 8 { photo_screen() }
else { if screen == 9 { found_screen() }
else { if screen == 10 { web_screen(video_src, "") }
else { web_screen(map_src, w_title) }}}}}}}}}}}
