// ---- platform_view_swift.splash
// platform_view_swift — flutter/samples/platform_view_swift
//
// Previously "no analogue": a native iOS UIViewController presenting a
// full-screen Flutter view, switching between them and passing a counter
// across. No UIKit here, so nothing to port.
//
// The UIKit part is true. What the sample is actually about — a platform's own
// rendering surface living in the same app as the framework-drawn tree, with
// state crossing between them — this stack does, and does the harder version:
// the surface sits *inside* the native tree rather than replacing it.
//
// `xcomp::surface(w, h)` is an ArkUI XComponent: a real EGL surface that camera
// preview and video decode render into, composited among the widgets Rust
// built. The state below is read from it.

fn screen_platform_view_swift() {
    return page(m_surface, [
        m_appbar("Platform View", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("A platform surface in the same tree", [
                {t: "column", fillw: 1, bg: m_surf_lowest, radius: 8, pad: 12,
                 spacing: 4, c: [
                    txt("surface.state", 13, 500, m_primary),
                    para(invoke("surface.state"), 12, 400, m_on_surf_var),
                ]},
                para("An ArkUI XComponent — a real EGL surface that camera "
                     + "preview and video decode render into, composited among "
                     + "the widgets Rust built. Not a view swap: the surface "
                     + "lives inside the tree.", 13, 400, m_on_surf_var),
            ]),
            m_section("How this differs from the sample", [
                para("The sample switches between a UIViewController and a "
                     + "full-screen Flutter view and passes a counter across a "
                     + "MethodChannel. Here both halves are on screen at once, "
                     + "and the channel equivalent is `invoke` — see the "
                     + "Platform Channels screen.", 13, 400, m_on_surf_var),
            ]),
            m_section("What has no equivalent", [
                para("UIKit. There is no UIViewController to present, no "
                     + "navigation controller to push onto, and no iOS target "
                     + "in this repo.", 13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

// ---- simple_sdf.splash
// simple_sdf — flutter/samples/simple_sdf
//
// sdHeart, evaluated in the DSL and drawn with native nodes.
//
// A signed distance field is arithmetic — fold on x, branch on p.y + p.x > 1,
// take the distance to the lobe or the cusp, sign it — and the DSL has
// arithmetic once it has sqrt, min and sign (see `_kit.splash`). So the field
// is computed here per cell and coloured exactly as the sample colours it:
// mix(pink, black, smoothstep(0.01, 0.02, d)).
//
// makepad would draw this per-pixel with Sdf2d, and that route is built; it
// does not resolve in the Splash isolate yet. This one runs on both backends.

let sdf_n = 22

fn sd_heart(px, py) {
    let x = absn(px)
    if py + x > 1.0 {
        let ax = x - 0.25
        let ay = py - 0.75
        return sqrtn(ax * ax + ay * ay) - 1.41421356 / 4.0
    }
    let bx = x
    let by = py - 1.0
    let d1 = bx * bx + by * by
    let m = maxn(x + py, 0.0) * 0.5
    let cx = x - m
    let cy = py - m
    let d2 = cx * cx + cy * cy
    return sqrtn(minn(d1, d2)) * signn(x - py)
}

fn sd_cell(ix, iy) {
    let pink = argb(255, 255, 105, 180)
    let black = argb(255, 0, 0, 0)
    // st = (uv - 0.5) * 2 ; st.y -= 0.5 ; st.y *= -1
    let sx = ((ix + 0.5) / sdf_n - 0.5) * 2.0
    let sy = 0.0 - (((iy + 0.5) / sdf_n - 0.5) * 2.0 - 0.5)
    let d = sd_heart(sx, sy)
    return lerp_argb(pink, black, smoothstepn(0.01, 0.02, d))
}

fn sd_grid() {
    let rows = []
    let j = 0
    while j < sdf_n {
        let cells = []
        let i = 0
        while i < sdf_n { cells.push({t: "column", fillw: 1, fillh: 1, bg: sd_cell(i, j)})  i = i + 1 }
        rows.push({t: "row", fillw: 1, fillh: 1, c: cells})
        j = j + 1
    }
    // 264 = 22 rows of 12dp, and 12dp is a whole number of physical pixels at
    // this display's density. Weight alone is not enough: a row height that
    // lands mid-pixel rounds, and the leftover fraction accumulates into a
    // visible seam every few rows. The width needs no such care — the cells
    // share one row and ArkUI absorbs the remainder there.
    return {t: "column", fillw: 1, h: 264, radius: 12, bg: argb(255, 0, 0, 0), c: rows}
}

fn screen_simple_sdf() {
    return page(m_surface, [
        m_appbar("Simple SDF", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            sd_grid(),
            m_section("What this is", [
                para("sdHeart from the sample's GLSL, evaluated per cell: fold "
                     + "on x, branch on p.y + p.x > 1, take the distance to the "
                     + "lobe or to the cusp, and sign it. Coloured the way the "
                     + "sample colours it, mix(pink, black, smoothstep(0.01, "
                     + "0.02, d)).", 13, 400, m_on_surf_var),
                para("The VM has no sqrt, min or sign, so those are in the kit — "
                     + "sqrt by Newton's method.", 13, 400, m_on_surf_var),
            ]),
            m_section("What the GPU would still do better", [
                para("Per-pixel instead of per-cell. makepad draws its own "
                     + "widgets this way with Sdf2d, and FlutterSdf is compiled "
                     + "and waiting; it does not resolve in the Splash isolate "
                     + "yet.", 13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

// ---- simple_shader.splash
// simple_shader — flutter/samples/simple_shader
//
// The sample's fragment shader, evaluated in the DSL and drawn with ordinary
// native nodes.
//
// A fragment shader is a function from a coordinate to a colour. The DSL has
// arithmetic, so it can run that function itself — once per cell instead of
// once per pixel — and emit a grid of coloured nodes. Coarser than the GPU
// doing it, and identical in kind: same maths, same colours, same picture.
//
// This is why the sample is no longer parked. The compiled-MPSL route
// (`FlutterShader` in splash-widgets) is still there and is the right answer on
// makepad, but it does not resolve in the Splash isolate yet. This works today,
// on both backends, and is verified on the phone.
//
// simple.frag: color = mix(mix(sky, blue, p*2), mix(blue, navy, p*2-1),
// step(0.5, p)) where p = (st.x + st.y) / 2.

let sh_n = 18

fn sh_cell(ix, iy) {
    let sky  = argb(255, 2, 125, 253)
    let blue = argb(255, 5, 83, 177)
    let navy = argb(255, 4, 43, 89)
    let x = (ix + 0.5) / sh_n
    let y = (iy + 0.5) / sh_n
    let p = (x + y) / 2.0
    if p < 0.5 { return lerp_argb(sky, blue, p * 2.0) }
    return lerp_argb(blue, navy, p * 2.0 - 1.0)
}

fn sh_grid() {
    let rows = []
    let j = 0
    while j < sh_n {
        let cells = []
        let i = 0
        while i < sh_n { cells.push({t: "column", fillw: 1, fillh: 1, bg: sh_cell(i, j)})  i = i + 1 }
        rows.push({t: "row", fillw: 1, fillh: 1, c: cells})
        j = j + 1
    }
    // Weighted rows inside a fixed-height column, not `h: 16` each — a fixed
    // row height rounds to a whole physical pixel and the leftover fraction
    // accumulates into a seam. See simple_sdf.splash.
    return {t: "column", fillw: 1, h: 288, radius: 12, bg: sh_cell(sh_n / 2, sh_n / 2), c: rows}
}

fn screen_simple_shader() {
    return page(m_surface, [
        m_appbar("Simple Shader", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            sh_grid(),
            m_section("What this is", [
                para("simple.frag, evaluated in the DSL: sky to blue to navy "
                     + "across (st.x + st.y) / 2, with the step at 0.5. A "
                     + "fragment shader is a function from a coordinate to a "
                     + "colour, and the DSL can run that function — once per "
                     + "cell rather than once per pixel.",
                     13, 400, m_on_surf_var),
            ]),
            m_section("What the GPU would still do better", [
                para("Per-pixel instead of per-cell, and for free. This grid is "
                     + "18x18 native nodes; the shader is one draw call.",
                     13, 400, m_on_surf_var),
                para("The compiled-MPSL route is built (FlutterShader in "
                     + "splash-widgets) and is the right answer on makepad, but "
                     + "it does not resolve in the Splash isolate yet. ArkUI has "
                     + "no fragment-shader path at all, so this is the form that "
                     + "works on both.", 13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

// ---- testing_app.splash
// testing_app — flutter/samples/testing_app
//
// A deliberately tiny favourites app (a 20-row list, a favourites screen, a
// snackbar on toggle) that exists as a fixture for the sample's unit, widget
// and integration tests.
//
// The UI ports in full. The reason the sample exists does not: its value is
// the `test/` and `integration_test/` directories — testWidgets, WidgetTester,
// pumpAndSettle, Key-based finders. There is no widget-test harness for the
// Splash pipeline, and the translated output is a makepad dialect string, so
// the closest analogue is asserting on that string — which is what
// `tests/flutter_samples.rs` in this repo does for every screen.

fn screen_testing_app() {
    let rows = []
    let i = 1
    while i <= 12 {
        let fav = 0
        if i == 2 { fav = 1 }
        if i == 5 { fav = 1 }
        if i == 9 { fav = 1 }
        rows.push({t: "column", fillw: 1, c: [
            {t: "row", fillw: 1, h: 56, padx: 16, spacing: 12, aligny: 0.5, c: [
                txt("Item " + i, 16, 400, m_on_surface),
                spacer(),
                icon(ic_heart, 15, pick_if(fav == 1, m_error, m_on_surf_var)),
            ]},
            rule(m_outline_var),
        ]})
        i = i + 1
    }
    return page(m_surface, [
        m_appbar("Testing Sample", "index"),
        {t: "row", fillw: 1, padx: 16, pady: 8, c: [
            spacer(),
            {t: "row", h: 40, radius: 20, bg: m_pri_cont, padx: 16, fitw: 1,
             spacing: 8, aligny: 0.5, tapto: "testing_app/favorites", c: [
                icon(ic_heart, 13, m_on_pri_cont),
                txt("Favorites", 14, 500, m_on_pri_cont),
            ]},
        ]},
        {t: "scroll", fillw: 1, c: rows},
        // The SnackBar the sample shows on each toggle.
        {t: "row", bg: m_inv_surf, radius: 4, fillw: 1, h: 48, padx: 16,
         aligny: 0.5, c: [ txt("Added to favorites.", 14, 400, m_inv_on) ]},
    ])
}

fn screen_testing_app_favorites() {
    let rows = []
    for n in ["Item 2", "Item 5", "Item 9"] {
        rows.push({t: "column", fillw: 1, c: [
            {t: "row", fillw: 1, h: 56, padx: 16, spacing: 12, aligny: 0.5, c: [
                txt(n, 16, 400, m_on_surface),
                spacer(),
                icon(ic_heart, 15, m_error),
            ]},
            rule(m_outline_var),
        ]})
    }
    return page(m_surface, [
        m_appbar("Favorites", "testing_app"),
        {t: "scroll", fillw: 1, c: rows},
    ])
}


// ---- tool.splash
// tool — flutter/samples/tool
//
// Not a UI port: this sample is configuration, tooling or prose. It states
// what the counterpart on this stack is rather than dismissing it.

fn screen_tool() {
    return counterpart_screen("tool",
        "The repository's CI helper: it walks every sample, runs flutter analyze and the tests over each, and reports which ones fail.",
        "The same job, done by `crates/splash-makepad/tests/flutter_samples.rs`. It sweeps every route in this kit, asserts each renders a string only that screen emits — because an unrecognised route silently falls through to the index and looks healthy — and pins the helper arities, the assembly order, and that every animation demo moves and is its own. `tools/visual-qa.sh` is the other half: it drives every route onto a real device and photographs it.",
        ["Nothing renders; this is the harness, not a screen.",
         "flutter analyze has no direct equivalent — clippy and rustc do that work at build time rather than as a separate sweep."])
}

