// ---- _kit.splash
// _kit.splash — shared tokens and helpers for the flutter/samples ports.
//
// Concatenated FIRST, ahead of every per-sample file, so each sample can call
// these helpers. Nothing here is sample-specific.
//
// Two palettes live side by side because flutter/samples does the same: the
// Material samples (material_3_demo, form_app, animations, …) are M3, and the
// Cupertino ones (cupertino_gallery, date_planner, platform_design) are iOS.
// Values are the real ones — M3 baseline tokens and Apple's system colours —
// not approximations.

fn argb(a, r, g, b) { return ((a * 256 + r) * 256 + g) * 256 + b }
// Pick dark (a) or light (b) by the injected st.dark flag.
fn pick(d, a, b) { if d == 1 { return a } return b }
// Same, for a boolean condition (a comparison result rather than an int flag).
fn pick_if(cond, a, b) { if cond { return a } return b }
let dk = st.dark

// ---- Material 3 baseline ---------------------------------------------------
let m_primary      = pick(dk, argb(255, 208, 188, 255), argb(255, 103,  80, 164))
let m_on_primary   = pick(dk, argb(255,  56,  30, 114), argb(255, 255, 255, 255))
let m_pri_cont     = pick(dk, argb(255,  79,  55, 139), argb(255, 234, 221, 255))
let m_on_pri_cont  = pick(dk, argb(255, 234, 221, 255), argb(255,  33,   0,  93))
let m_secondary    = pick(dk, argb(255, 204, 194, 220), argb(255,  98,  91, 113))
let m_sec_cont     = pick(dk, argb(255,  74,  68,  88), argb(255, 232, 222, 248))
let m_on_sec_cont  = pick(dk, argb(255, 232, 222, 248), argb(255,  29,  25,  43))
let m_tertiary     = pick(dk, argb(255, 239, 184, 200), argb(255, 125,  82,  96))
let m_ter_cont     = pick(dk, argb(255,  99,  59,  72), argb(255, 255, 216, 228))
let m_on_ter_cont  = pick(dk, argb(255, 255, 216, 228), argb(255,  49,  17,  29))
let m_error        = pick(dk, argb(255, 242, 184, 181), argb(255, 179,  38,  30))
let m_err_cont     = pick(dk, argb(255, 140,  29,  24), argb(255, 249, 222, 220))
let m_surface      = pick(dk, argb(255,  20,  18,  24), argb(255, 254, 247, 255))
let m_surf_var     = pick(dk, argb(255,  73,  69,  79), argb(255, 231, 224, 236))
let m_on_surface   = pick(dk, argb(255, 230, 224, 233), argb(255,  29,  27,  32))
let m_on_surf_var  = pick(dk, argb(255, 202, 196, 208), argb(255,  73,  69,  79))
let m_outline      = pick(dk, argb(255, 147, 143, 153), argb(255, 121, 116, 126))
let m_outline_var  = pick(dk, argb(255,  73,  69,  79), argb(255, 202, 196, 208))
let m_surf_lowest  = pick(dk, argb(255,  15,  13,  19), argb(255, 255, 255, 255))
let m_surf_low     = pick(dk, argb(255,  29,  27,  32), argb(255, 247, 242, 250))
let m_surf_cont    = pick(dk, argb(255,  33,  31,  38), argb(255, 243, 237, 247))
let m_surf_high    = pick(dk, argb(255,  43,  41,  48), argb(255, 236, 230, 240))
let m_surf_highest = pick(dk, argb(255,  54,  52,  59), argb(255, 230, 224, 233))
let m_inv_surf     = pick(dk, argb(255, 230, 224, 233), argb(255,  50,  47,  53))
let m_inv_on       = pick(dk, argb(255,  50,  47,  53), argb(255, 245, 239, 247))

// ---- Cupertino / iOS system colours ----------------------------------------
// Apple's systemX colours, light and dark variants.
let c_bg           = pick(dk, argb(255,   0,   0,   0), argb(255, 242, 242, 247))
let c_grouped      = pick(dk, argb(255,  28,  28,  30), argb(255, 255, 255, 255))
let c_label        = pick(dk, argb(255, 255, 255, 255), argb(255,   0,   0,   0))
let c_label2       = pick(dk, argb(255, 152, 152, 159), argb(255, 138, 138, 142))
let c_separator    = pick(dk, argb(255,  56,  56,  58), argb(255, 198, 198, 200))
let c_fill         = pick(dk, argb(255,  44,  44,  46), argb(255, 232, 232, 234))
let c_blue         = pick(dk, argb(255,  10, 132, 255), argb(255,   0, 122, 255))
let c_green        = pick(dk, argb(255,  48, 209,  88), argb(255,  52, 199,  89))
let c_indigo       = pick(dk, argb(255,  94,  92, 230), argb(255,  88,  86, 214))
let c_orange       = pick(dk, argb(255, 255, 159,  10), argb(255, 255, 149,   0))
let c_red          = pick(dk, argb(255, 255,  69,  58), argb(255, 255,  59,  48))
let c_yellow       = pick(dk, argb(255, 255, 214,  10), argb(255, 255, 204,   0))
let c_purple       = pick(dk, argb(255, 191,  90, 242), argb(255, 175,  82, 222))
let c_cyan         = pick(dk, argb(255, 100, 210, 255), argb(255,  50, 173, 230))
