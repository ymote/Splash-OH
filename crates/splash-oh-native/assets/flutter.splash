// ---- simple_sdf.splash
// simple_sdf — flutter/samples/simple_sdf
fn screen_simple_sdf() {
    return na_screen("simple_sdf",
        "Drawing signed distance functions with Flutter's FragmentShader API — "
        + "a GLSL fragment shader loaded from an asset and painted by a "
        + "CustomPainter.",
        [
            "makepad is the one place this is nearly the opposite of impossible: its widgets are drawn by MPSL shaders, and Sdf2d is a first-class SDF drawing API.",
            "But it is unreachable from here. The Splash DSL has no shader node — NodeKind has 23 kinds and none of them carry source.",
            "The translator emits a widget dialect string; a shader must be compiled at build time by script_mod!, which a runtime string never reaches. That is the same constraint this repo's fork-free theming is built on.",
        ],
        "Not portable via the DSL — but the capability is right there in makepad. An `sdf` node whose shader body compiles through splash-widgets is the obvious way in.")
}


// ---- simple_shader.splash
// simple_shader — flutter/samples/simple_shader
fn screen_simple_shader() {
    return na_screen("simple_shader",
        "The minimal Flutter fragment-shader sample: a GLSL shader declared in "
        + "pubspec.yaml, loaded at runtime and painted across a box.",
        [
            "Same constraint as simple_sdf: makepad has MPSL and paints every widget with it, but no DSL node carries shader source.",
            "Shaders compile at build time here. script_mod! compiles MPSL when the crate is built; a runtime string is never compiled, and a widget given one renders blank — verified on device by this repo's theming work.",
        ],
        "Not portable via the DSL. Reaching it means a compiled shader variant in splash-widgets that a DSL node selects by name.")
}


// ---- testing_app.splash
// testing_app — flutter/samples/testing_app
//
// A deliberately tiny favourites app (a 20-row list, a favourites screen, a
// snackbar on toggle) that exists as a fixture for the sample's unit, widget
// and integration tests.
//
// The UI ports in full. The reason the sample exists does not: its value is
// the `test/` and `integration_test/` directories — testWidgets, WidgetTester,
// pumpAndSettle, Key-based finders. There is no widget-test harness for the
// Splash pipeline, and the translated output is a makepad dialect string, so
// the closest analogue is asserting on that string — which is what
// `tests/flutter_samples.rs` in this repo does for every screen.

fn screen_testing_app() {
    let rows = []
    let i = 1
    while i <= 12 {
        let fav = 0
        if i == 2 { fav = 1 }
        if i == 5 { fav = 1 }
        if i == 9 { fav = 1 }
        rows.push({t: "column", fillw: 1, c: [
            {t: "row", fillw: 1, h: 56, padx: 16, spacing: 12, aligny: 0.5, c: [
                txt("Item " + i, 16, 400, m_on_surface),
                spacer(),
                icon(ic_heart, 15, pick_if(fav == 1, m_error, m_on_surf_var)),
            ]},
            rule(m_outline_var),
        ]})
        i = i + 1
    }
    return page(m_surface, [
        m_appbar("Testing Sample", "index"),
        {t: "row", fillw: 1, padx: 16, pady: 8, c: [
            spacer(),
            {t: "row", h: 40, radius: 20, bg: m_pri_cont, padx: 16, fitw: 1,
             spacing: 8, aligny: 0.5, tapto: "testing_app/favorites", c: [
                icon(ic_heart, 13, m_on_pri_cont),
                txt("Favorites", 14, 500, m_on_pri_cont),
            ]},
        ]},
        {t: "scroll", fillw: 1, c: rows},
        // The SnackBar the sample shows on each toggle.
        {t: "row", bg: m_inv_surf, radius: 4, fillw: 1, h: 48, padx: 16,
         aligny: 0.5, c: [ txt("Added to favorites.", 14, 400, m_inv_on) ]},
    ])
}

fn screen_testing_app_favorites() {
    let rows = []
    for n in ["Item 2", "Item 5", "Item 9"] {
        rows.push({t: "column", fillw: 1, c: [
            {t: "row", fillw: 1, h: 56, padx: 16, spacing: 12, aligny: 0.5, c: [
                txt(n, 16, 400, m_on_surface),
                spacer(),
                icon(ic_heart, 15, m_error),
            ]},
            rule(m_outline_var),
        ]})
    }
    return page(m_surface, [
        m_appbar("Favorites", "testing_app"),
        {t: "scroll", fillw: 1, c: rows},
    ])
}


