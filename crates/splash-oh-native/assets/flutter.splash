// ---- web_embedding.splash
// web_embedding — flutter/samples/web_embedding
//
// Previously "no analogue": the sample is HTML, JavaScript and TypeScript
// around a Flutter web build, and makepad owns a canvas with no hostElement
// contract to embed into.
//
// True of makepad, and it was the wrong thing to check. Splash-OH's whole
// hybrid is this: a web surface composited into a tree of native widgets, with
// the native side reserving the space and ArkTS putting a real Web component
// there. The bridge's own browser and frontend cards do it; the DSL can now
// reach it through a `web` node.
//
// The sample embeds Flutter *into* a page. This embeds a page into native
// widgets. Same seam, opposite direction — which is the honest comparison,
// because a Flutter build is not the thing being hosted here.
//
// Geometry is explicit on purpose. A web slot needs absolute coordinates and
// the DSL tree does not know where a node lands, so the screen says. That is
// the same thing frontend.rs does in Rust.
//
// In vp, the unit every other length in this kit is in. It used to say
// `w: 1320.0` -- the phone's *physical* width -- which ArkTS then applied as
// 1320vp, roughly 4300px. ArkUI does not clamp that; it dereferenced a null
// frame node inside SetWidth and took the whole app down. A width of 0 now
// means "as wide as the page", so no screen has to name a device pixel count.
let we_top = 90.0
let we_h = 300.0

fn screen_web_embedding() {
    let native_or_note = pick_if(st.backend == "arkui",
        // The hole: this reserves the space, and the host puts a real WebView
        // at exactly these coordinates.
        {t: "web", src: "https://flutter.dev", fillw: 1, h: we_h,
         x: 0.0, y: we_top, w: 0.0},
        {t: "column", fillw: 1, h: 240, radius: 12, bg: m_surf_highest,
         alignx: 0.5, aligny: 0.5, pad: 24, c: [
            para("A web surface needs a WebView the host composites. The "
                 + "makepad backend owns its own canvas and has none, so there "
                 + "is nothing to embed here — this screen is the ArkUI half.",
                 13, 400, m_on_surf_var),
         ]})

    return page(m_surface, [
        m_appbar("Web Embedding", "index"),
        {t: "column", fillw: 1, padx: 16, pady: 8, c: [
            para("Native widgets above, a real web surface below — one tree.",
                 13, 400, m_on_surf_var),
        ]},
        native_or_note,
        {t: "column", fillw: 1, pad: 16, spacing: 12, c: [
            m_section("Which direction this goes", [
                para("The sample embeds a Flutter build into an existing page, "
                     + "with and without Angular. This embeds a page into "
                     + "native widgets: the native side reserves a hole and "
                     + "ArkTS positions a Web component into it.",
                     13, 400, m_on_surf_var),
            ]),
            m_section("What is still missing", [
                para("The slot's y is still written by hand. A web surface "
                     + "needs absolute geometry and the DSL tree does not know "
                     + "where a node lands, so a screen that wants one has to "
                     + "say — the same thing the bridge's own cards do in Rust. "
                     + "The width no longer is: 0 means as wide as the page.",
                     13, 400, m_on_surf_var),
                para("The sample's interop — JavaScript calling into Dart — has "
                     + "its counterpart in `splash.invoke`, which the "
                     + "platform_channels screen shows.", 13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

// ---- _index.splash
// _index.splash — the catalog index and the router.
//
// Concatenated LAST. Everything above defines `fn screen_*`; this file picks
// one by `st.route` and leaves it as the script's value.
//
// Two things about the makepad-script VM shape this file:
//
//   1. A bare function call as the final top-level expression evaluates to nil,
//      so the chosen node is bound to `node` and the file ends by naming it.
//   2. There is no substring or startsWith. Parameterised routes are matched by
//      rebuilding the full route string from the same data the screen uses and
//      comparing for equality — see the `for` loops below.

// dir, label, status, route
//
// status  2  the screen does the thing — live host data, or it actually moves
//         1  drawn, not working — the geometry and tokens are transcribed from
//            the sample, the behaviour behind them is not
//         0  a note. No port; it says what the counterpart here is
//
// This used to read `1` for all 27 and the index drew a check beside every one.
// That was the complaint, and it was right: a screen that only describes a
// capability was being counted as done. The split below is an outside review's
// (gpt-5.6-terra) classification, not mine.
let fs_samples = [
    ["material_3_demo", "Material 3 Demo", 1, "material_3_demo"],
    ["cupertino_gallery", "Cupertino Gallery", 1, "cupertino_gallery"],
    ["date_planner", "Date Planner", 1, "date_planner"],
    ["platform_design", "Platform Design", 1, "platform_design"],
    ["animations", "Animations", 2, "animations"],
    ["form_app", "Form App", 1, "form_app"],
    ["navigation_and_routing", "Navigation and Routing", 2, "navigation_and_routing"],
    ["compass_app", "Compass App", 1, "compass_app"],
    ["desktop_photo_search", "Desktop Photo Search", 1, "desktop_photo_search"],
    ["dynamic_theme", "Dynamic Theme", 1, "dynamic_theme"],
    ["testing_app", "Testing App", 1, "testing_app"],
    ["add_to_app", "Add to App", 2, "add_to_app"],
    ["analysis_defaults", "Analysis Defaults", 0, "analysis_defaults"],
    ["android_splash_screen", "Android Splash Screen", 0, "android_splash_screen"],
    ["asset_transformation", "Asset Transformation", 1, "asset_transformation"],
    ["background_isolate_channels", "Background Isolate Channels", 1, "background_isolate_channels"],
    ["docs", "docs", 0, "docs"],
    ["google_maps", "Google Maps", 1, "google_maps"],
    ["ios_app_clip", "iOS App Clip", 0, "ios_app_clip"],
    ["pedometer", "Pedometer", 1, "pedometer"],
    ["platform_channels", "Platform Channels", 1, "platform_channels"],
    ["platform_view_swift", "Platform View Swift", 1, "platform_view_swift"],
    ["simple_sdf", "Simple SDF", 1, "simple_sdf"],
    ["simple_shader", "Simple Shader", 1, "simple_shader"],
    ["tool", "tool", 0, "tool"],
    ["veggieseasons", "Veggie Seasons", 0, "veggieseasons"],
    ["web_embedding", "Web Embedding", 1, "web_embedding"],
]

fn fs_index_row(label, dir, status) {
    // A check only where the screen does the thing. Drawn-but-inert gets a
    // half-filled dot, a note gets a page glyph — so the list cannot read as
    // 27 finished ports at a glance, which is exactly how it used to read.
    let tint = pick_if(status == 2, m_pri_cont,
               pick_if(status == 1, m_surf_highest, m_surf_cont))
    let ink = pick_if(status == 2, m_on_pri_cont, m_on_surf_var)
    let glyph = pick_if(status == 2, ic_check,
                pick_if(status == 1, ic_paint, ic_file))
    return {t: "row", fillw: 1, h: 64, padx: 16, spacing: 12, aligny: 0.5,
            tapto: dir, c: [
        {t: "column", w: 36, h: 36, radius: 10, bg: tint, alignx: 0.5, aligny: 0.5,
         c: [ icon(glyph, 14, ink) ]},
        {t: "column", fitw: 1, spacing: 2, c: [
            txt(label, 16, 400, m_on_surface),
            txt(dir, 12, 400, m_on_surf_var),
        ]},
        spacer(),
        icon(ic_fwd, 12, m_on_surf_var),
    ]}
}

fn fs_count_card(n, label, bg, ink) {
    return {t: "column", fillw: 1, radius: 12, bg: bg, pad: 12, spacing: 2, c: [
        txt(n, 26, 500, ink),
        txt(label, 11, 400, ink),
    ]}
}

fn screen_index() {
    let working = []
    let drawn = []
    let notes = []
    for s in fs_samples {
        let row = fs_index_row(s[1], s[0], s[2])
        if s[2] == 2 { working.push(row) }
        if s[2] == 1 { drawn.push(row) }
        if s[2] == 0 { notes.push(row) }
    }
    return page(m_surface, [
        {t: "column", bg: m_surf_cont, fillw: 1, padx: 16, pady: 16, spacing: 4, c: [
            txt("flutter/samples", 28, 400, m_on_surface),
            para("All 27 directories have a screen. Three of them work; most "
                + "are the sample drawn accurately and not wired up; six are "
                + "notes, not ports.", 14, 400, m_on_surf_var),
        ]},
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            {t: "row", fillw: 1, spacing: 8, c: [
                fs_count_card("3", "work", m_pri_cont, m_on_pri_cont),
                fs_count_card("18", "drawn only", m_surf_highest, m_on_surface),
                fs_count_card("6", "notes", m_surf_cont, m_on_surf_var),
            ]},
            m_section("Working — live host data, or it moves", working),
            m_section("Drawn, not wired up", drawn),
            m_section("Notes, not ports", notes),
            {t: "column", fillw: 1, tapto: "theme:toggle",
             c: [ m_btn_outlined("Toggle light / dark") ]},
        ]},
    ])
}

