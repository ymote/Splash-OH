let c_gray         = pick(dk, argb(255, 142, 142, 147), argb(255, 142, 142, 147))

let white = argb(255, 255, 255, 255)
let black = argb(255,   0,   0,   0)
let clear = argb(  0,   0,   0,   0)

// ---- Font Awesome codepoints (the theme's icon face) ------------------------
let ic_back    = "\u{f053}"
let ic_fwd     = "\u{f054}"
let ic_home    = "\u{f015}"
let ic_list    = "\u{f03a}"
let ic_gear    = "\u{f013}"
let ic_search  = "\u{f002}"
let ic_heart   = "\u{f004}"
