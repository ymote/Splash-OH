                fa_field("Name", "Enter your name"),
                fa_field("Phone number", "Enter your phone number"),
                fa_field("Email", "Enter your email address"),
                fa_field("Street address", "Enter your street address"),
                m_btn("Submit", m_primary, m_on_primary),
