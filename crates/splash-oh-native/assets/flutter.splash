// ---- material_3_demo.splash
// material_3_demo — flutter/samples/material_3_demo
//
// The Flutter sample is a four-screen Material 3 showcase behind a
// NavigationBar (NavigationRail above 450dp): Components, Color, Typography,
// Elevation. Ported here as four sub-routes; the bottom bar re-routes.
//
// Sizes are the real M3 tokens the Flutter sample renders: the 15 type-scale
// roles at their sp values, and the six elevation levels with the dp and
// surface-tint overlay percentages from elevation_screen.dart.

fn m3_tabbar(active) {
    let items = [
        ["Components", ic_cube,  "material_3_demo"],
        ["Color",      ic_paint, "material_3_demo/color"],
        ["Typography", ic_code,  "material_3_demo/typography"],
        ["Elevation",  ic_layer, "material_3_demo/elevation"],
    ]
    let cells = []
    for it in items {
        let sel = it[0] == active
        let pill_bg = pick_if(sel, m_sec_cont, clear)
        let ink = pick_if(sel, m_on_sec_cont, m_on_surf_var)
        cells.push({t: "column", fillw: 1, h: 80, spacing: 4, alignx: 0.5, aligny: 0.5,
                    tapto: it[2], c: [
            {t: "column", w: 64, h: 32, radius: 16, bg: pill_bg, alignx: 0.5, aligny: 0.5,
             c: [ icon(it[1], 15, ink) ]},
            txt(it[0], 12, 500, ink),
        ]})
    }
    return {t: "column", fillw: 1, bg: m_surf_cont, c: [
        rule(m_outline_var),
        {t: "row", fillw: 1, h: 80, c: cells},
    ]}
}

fn m3_page(active, body_kids) {
    let kids = [ m_appbar("Material 3", "index") ]
    kids.push({t: "scroll", fillw: 1, pad: 16, spacing: 16, c: body_kids})
    kids.push(m3_tabbar(active))
    return page(m_surface, kids)
}

// ---- Components -------------------------------------------------------------

fn screen_material_3_demo() {
    // Common buttons — the five M3 variants, in the sample's order.
    let buttons = {t: "row", fillw: 1, spacing: 8, c: [
        m_btn("Elevated", m_surf_low, m_primary),
        m_btn("Filled", m_primary, m_on_primary),
        m_btn("Tonal", m_sec_cont, m_on_sec_cont),
    ]}
    let buttons2 = {t: "row", fillw: 1, spacing: 8, c: [
        m_btn_outlined("Outlined"),
        m_btn_text("Text"),
    ]}

    // Floating action buttons — small (40), regular (56), extended.
    let fabs = {t: "row", fillw: 1, spacing: 12, aligny: 0.5, c: [
        {t: "column", w: 40, h: 40, radius: 12, bg: m_pri_cont, elevation: 6,
         alignx: 0.5, aligny: 0.5, c: [ icon(ic_plus, 14, m_on_pri_cont) ]},
        {t: "column", w: 56, h: 56, radius: 16, bg: m_pri_cont, elevation: 6,
         alignx: 0.5, aligny: 0.5, c: [ icon(ic_plus, 18, m_on_pri_cont) ]},
        {t: "row", h: 56, radius: 16, bg: m_pri_cont, elevation: 6, padx: 16,
         fitw: 1, spacing: 8, aligny: 0.5, c: [
            icon(ic_plus, 15, m_on_pri_cont),
            txt("Create", 14, 500, m_on_pri_cont),
        ]},
    ]}

    // Cards — elevated / filled / outlined.
    let cards = {t: "row", fillw: 1, spacing: 12, c: [
        {t: "column", fillw: 1, h: 88, radius: 12, bg: m_surf_lowest, elevation: 1,
         pad: 12, c: [ txt("Elevated", 14, 400, m_on_surface) ]},
        {t: "column", fillw: 1, h: 88, radius: 12, bg: m_surf_highest,
         pad: 12, c: [ txt("Filled", 14, 400, m_on_surface) ]},
        {t: "column", fillw: 1, h: 88, radius: 12, bg: m_surface, border: 1,
         bordercolor: m_outline_var, pad: 12,
         c: [ txt("Outlined", 14, 400, m_on_surface) ]},
    ]}

    // Switches, checkboxes, radios — real native makepad controls.
    let switches = {t: "row", fillw: 1, spacing: 16, aligny: 0.5, c: [
        {t: "toggle", on: 1, w: 52, h: 32}, {t: "toggle", on: 0, w: 52, h: 32},
    ]}
    let checks = {t: "column", fillw: 1, spacing: 4, c: [
        check_row("Option 1", 1), check_row("Option 2", 1),
        check_row("Option 3", 0), check_row("Option 4", 0),
    ]}
    let radios = {t: "column", fillw: 1, spacing: 4, c: [
        radio_row("Option 1", 1), radio_row("Option 2", 0), radio_row("Option 3", 0),
    ]}

    // Chips — assist / filter (selected) / input.
    let chips = {t: "row", fillw: 1, spacing: 8, c: [
        m_chip("Assist", 0), m_chip("Filter", 1), m_chip("Input", 0),
    ]}

    // Progress indicators — the animated spinner and the M3 shape-morph.
    let progress = {t: "row", fillw: 1, spacing: 20, aligny: 0.5, c: [
        {t: "loading", w: 40, h: 40, bg: m_primary},
        {t: "progress", w: 40, h: 40, bg: m_primary},
        {t: "column", fillw: 1, h: 4, radius: 2, bg: m_sec_cont, c: [
            {t: "column", w: 140, h: 4, radius: 2, bg: m_primary},
        ]},
    ]}

    // Text fields — filled and outlined.
    let fields = {t: "column", fillw: 1, spacing: 12, c: [
        {t: "column", fillw: 1, h: 56, radius: 4, bg: m_surf_highest, padx: 16,
         aligny: 0.5, c: [ {t: "input", placeholder: "Filled", fillw: 1, fith: 1} ]},
        {t: "column", fillw: 1, h: 56, radius: 4, bg: m_surface, border: 1,
         bordercolor: m_outline, padx: 16, aligny: 0.5,
         c: [ {t: "input", placeholder: "Outlined", fillw: 1, fith: 1} ]},
    ]}

    // Dialog — drawn inline as the sample's AlertDialog content.
    let dialog = {t: "column", fillw: 1, radius: 28, bg: m_surf_high, pad: 24,
                  spacing: 16, elevation: 6, c: [
        txt("What is a dialog?", 24, 400, m_on_surface),
        para("A dialog is a type of modal window that appears in front of app content.",
             14, 400, m_on_surf_var),
        {t: "row", fillw: 1, spacing: 8, alignx: 1.0, c: [
            m_btn_text("Dismiss"), m_btn_text("Okay"),
        ]},
    ]}

    return m3_page("Components", [
        m_section("Common buttons", [ buttons, buttons2 ]),
        m_section("Floating action buttons", [ fabs ]),
        m_section("Cards", [ cards ]),
        m_section("Text fields", [ fields ]),
        m_section("Chips", [ chips ]),
        m_section("Switches", [ switches ]),
        m_section("Checkboxes", [ checks ]),
        m_section("Radio buttons", [ radios ]),
        m_section("Progress indicators", [ progress ]),
        m_section("Dialog", [ dialog ]),
        m_section("Dividers", [ rule(m_outline_var) ]),
    ])
}

// ---- Color ------------------------------------------------------------------
// The sample's ColorPalettesScreen: each key colour with its on-/container
// pairing, drawn as the M3 role swatches.

fn screen_material_3_demo_color() {
    let rows = [
        ["Primary",   m_primary,   m_on_primary,  "Primary Container", m_pri_cont, m_on_pri_cont],
        ["Secondary", m_secondary, m_surface,     "Secondary Container", m_sec_cont, m_on_sec_cont],
        ["Tertiary",  m_tertiary,  m_surface,     "Tertiary Container", m_ter_cont, m_on_ter_cont],
        ["Error",     m_error,     m_surface,     "Error Container", m_err_cont, m_error],
    ]
    let out = []
    for r in rows {
        out.push({t: "row", fillw: 1, h: 64, radius: 8, c: [
            {t: "column", fillw: 1, fillh: 1, bg: r[1], pad: 10, aligny: 1.0,
             c: [ para(r[0], 12, 500, r[2]) ]},
            {t: "column", fillw: 1, fillh: 1, bg: r[4], pad: 10, aligny: 1.0,
             c: [ para(r[3], 12, 500, r[5]) ]},
        ]})
    }
    let surfaces = []
    let stones = [
        ["Surface", m_surface], ["Surf Container Lowest", m_surf_lowest],
        ["Surf Container Low", m_surf_low], ["Surf Container", m_surf_cont],
        ["Surf Container High", m_surf_high], ["Surf Container Highest", m_surf_highest],
    ]
    for s in stones {
        surfaces.push({t: "row", fillw: 1, h: 40, radius: 6, bg: s[1], padx: 12,
                       border: 1, bordercolor: m_outline_var, aligny: 0.5,
                       c: [ txt(s[0], 12, 500, m_on_surface) ]})
    }
    return m3_page("Color", [
        m_section("Key colors", out),
        m_section("Surface tones", surfaces),
    ])
}

// ---- Typography -------------------------------------------------------------
// The 15 M3 type-scale roles at their real sp sizes.

fn screen_material_3_demo_typography() {
    let scale = [
        ["Display Large", 57], ["Display Medium", 45], ["Display Small", 36],
        ["Headline Large", 32], ["Headline Medium", 28], ["Headline Small", 24],
        ["Title Large", 22], ["Title Medium", 16], ["Title Small", 14],
        ["Label Large", 14], ["Label Medium", 12], ["Label Small", 11],
        ["Body Large", 16], ["Body Medium", 14], ["Body Small", 12],
    ]
    let rows = []
    for s in scale {
        rows.push({t: "column", fillw: 1, spacing: 2, c: [
            para(s[0], s[1], 400, m_on_surface),
            txt(s[1] + "sp", 11, 400, m_on_surf_var),
        ]})
    }
    return m3_page("Typography", [ m_section("Type scale", rows) ])
}

// ---- Elevation --------------------------------------------------------------
// Levels 0-5 with the sample's dp and surface-tint overlay percentages.

fn screen_material_3_demo_elevation() {
    let levels = [
        [0, 0, 0], [1, 1, 5], [2, 3, 8], [3, 6, 11], [4, 8, 12], [5, 12, 14],
    ]
    let cards = []
    for lv in levels { cards.push(elev_card(lv[0], lv[1], lv[2])) }
    return m3_page("Elevation", [
        m_section("Surface tint color and shadow color", cards),
    ])
}

fn elev_card(level, dp, overlay) {
    return {t: "row", fillw: 1, h: 72, radius: 12, bg: m_surf_low, elevation: dp,
            padx: 16, spacing: 12, aligny: 0.5, c: [
        {t: "column", fitw: 1, c: [
            txt("Level " + level, 14, 500, m_on_surface),
            txt(dp + " dp", 12, 400, m_on_surf_var),
        ]},
        spacer(),
        txt(overlay + "%", 12, 400, m_on_surf_var),
    ]}
}

// ---- small shared component rows -------------------------------------------

fn check_row(label, on) {
    return {t: "row", fillw: 1, h: 40, spacing: 12, aligny: 0.5, c: [
        {t: "checkbox", on: on, w: 18, h: 18},
        txt(label, 14, 400, m_on_surface),
    ]}
}

fn radio_row(label, on) {
    return {t: "row", fillw: 1, h: 40, spacing: 12, aligny: 0.5, c: [
        {t: "radio", on: on, w: 16, h: 16},
        txt(label, 14, 400, m_on_surface),
    ]}
}

fn m_chip(label, selected) {
    let bg = pick_if(selected, m_sec_cont, m_surface)
    let ink = pick_if(selected, m_on_sec_cont, m_on_surf_var)
    let bd = pick_if(selected, 0, 1)
    return {t: "column", bg: bg, border: bd, bordercolor: m_outline_var, radius: 8,
            h: 32, pad: 8, fitw: 1, alignx: 0.5, aligny: 0.5,
            c: [ txt(label, 14, 500, ink) ]}
}


// ---- navigation_and_routing.splash
// navigation_and_routing — flutter/samples/navigation_and_routing
//
// A small library browser used to demonstrate Router/go_router: a Books screen
// with Popular / New / All tabs, an Authors screen, book and author details,
// Settings, and a sign-in gate.
//
// The four books and three authors are the real libraryInstance data. What does
// not port is the point of the sample: the Router API itself — declarative
// route parsing, deep links, browser history, the auth redirect. `tapto` is a
// one-string signal the host matches; there is no route table, no stack, no
// back entry. Every screen here is reachable, but by re-mount, not by routing.

// title, author, popular, new, key
let nr_books = [
    ["Left Hand of Darkness", "Ursula K. Le Guin", 1, 1, "0"],
    ["Too Like the Lightning", "Ada Palmer", 0, 1, "1"],
    ["Kindred", "Octavia E. Butler", 1, 0, "2"],
    ["The Lathe of Heaven", "Ursula K. Le Guin", 0, 0, "3"],
]

let nr_authors = [
    ["Ursula K. Le Guin", "2 books", "0"],
    ["Ada Palmer", "1 book", "1"],
    ["Octavia E. Butler", "1 book", "2"],
]

fn nr_tabbar(active) {
    let tabs = [
        ["Popular", "navigation_and_routing"],
        ["New", "navigation_and_routing/new"],
        ["All", "navigation_and_routing/all"],
    ]
    let cells = []
    for t in tabs {
        let sel = t[0] == active
        let ink = pick_if(sel, m_primary, m_on_surf_var)
        cells.push({t: "column", fillw: 1, fillh: 1, alignx: 0.5, aligny: 1.0,
                    tapto: t[1], c: [
            {t: "column", fillw: 1, alignx: 0.5, c: [ txt(t[0], 14, 500, ink) ]},
            {t: "column", fillw: 1, h: 3, bg: pick_if(sel, m_primary, clear)},
        ]})
    }
    return {t: "column", fillw: 1, bg: m_surf_cont, c: [
        {t: "row", fillw: 1, h: 48, c: cells},
        rule(m_outline_var),
    ]}
}

fn nr_booklist(filter) {
    let rows = []
    for b in nr_books {
        let show = 0
        if filter == "all" { show = 1 }
        if filter == "popular" { if b[2] == 1 { show = 1 } }
        if filter == "new" { if b[3] == 1 { show = 1 } }
        if show == 1 {
            rows.push({t: "row", fillw: 1, fith: 1, padx: 16, pady: 8, spacing: 12,
                       aligny: 0.5, tapto: "navigation_and_routing/book/" + b[4], c: [
                {t: "column", w: 36, h: 48, radius: 4, bg: m_pri_cont,
                 alignx: 0.5, aligny: 0.5, c: [ icon(ic_book, 14, m_on_pri_cont) ]},
                {t: "column", fillw: 1, fith: 1, spacing: 2, c: [
                    para(b[0], 16, 400, m_on_surface),
                    txt(b[1], 13, 400, m_on_surf_var),
                ]},
                icon(ic_fwd, 12, m_on_surf_var),
            ]})
        }
    }
    return rows
}

fn nr_page(active, filter) {
    return page(m_surface, [
        m_appbar("Books", "index"),
        nr_tabbar(active),
        {t: "scroll", fillw: 1, c: nr_booklist(filter) },
        nr_bottombar("Books"),
    ])
}

fn nr_bottombar(active) {
    let items = [
        ["Books", ic_book, "navigation_and_routing"],
        ["Authors", ic_user, "navigation_and_routing/authors"],
        ["Settings", ic_gear, "navigation_and_routing/settings"],
    ]
    let cells = []
    for it in items {
        let ink = pick_if(it[0] == active, m_primary, m_on_surf_var)
        cells.push({t: "column", fillw: 1, h: 80, spacing: 4, alignx: 0.5,
                    aligny: 0.5, tapto: it[2],
                    c: [ icon(it[1], 15, ink), txt(it[0], 12, 500, ink) ]})
    }
    return {t: "column", fillw: 1, bg: m_surf_cont, c: [
        rule(m_outline_var), {t: "row", fillw: 1, h: 80, c: cells},
    ]}
}

fn screen_navigation_and_routing() { return nr_page("Popular", "popular") }
fn screen_navigation_and_routing_new() { return nr_page("New", "new") }
fn screen_navigation_and_routing_all() { return nr_page("All", "all") }

fn screen_navigation_and_routing_authors() {
    let rows = []
    for a in nr_authors {
        rows.push({t: "row", fillw: 1, fith: 1, padx: 16, pady: 8, spacing: 12,
                   aligny: 0.5, tapto: "navigation_and_routing/author/" + a[2], c: [
            {t: "column", w: 40, h: 40, radius: 20, bg: m_ter_cont,
             alignx: 0.5, aligny: 0.5, c: [ icon(ic_user, 14, m_on_ter_cont) ]},
            {t: "column", fillw: 1, fith: 1, spacing: 2, c: [
                para(a[0], 16, 400, m_on_surface),
                txt(a[1], 13, 400, m_on_surf_var),
            ]},
            icon(ic_fwd, 12, m_on_surf_var),
        ]})
    }
    return page(m_surface, [
        m_appbar("Authors", "index"),
        {t: "scroll", fillw: 1, c: rows},
        nr_bottombar("Authors"),
    ])
}

fn screen_navigation_and_routing_book(key) {
    let title = ""
    let author = ""
    for b in nr_books { if b[4] == key { title = b[0]; author = b[1] } }
    return page(m_surface, [
        m_appbar("Book", "navigation_and_routing"),
        {t: "scroll", fillw: 1, pad: 24, spacing: 16, alignx: 0.5, c: [
            {t: "column", w: 96, h: 128, radius: 8, bg: m_pri_cont, elevation: 2,
             alignx: 0.5, aligny: 0.5, c: [ icon(ic_book, 34, m_on_pri_cont) ]},
            txt(title, 24, 400, m_on_surface),
            txt(author, 16, 400, m_on_surf_var),
            m_btn_outlined("View author"),
        ]},
    ])
}

fn screen_navigation_and_routing_author(key) {
    let name = ""
    for a in nr_authors { if a[2] == key { name = a[0] } }
    let rows = []
    for b in nr_books {
        if b[1] == name {
            rows.push(m_navrow(b[0], "navigation_and_routing/book/" + b[4]))
        }
    }
    return page(m_surface, [
        m_appbar("Author", "navigation_and_routing/authors"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            {t: "column", fillw: 1, spacing: 8, alignx: 0.5, pady: 12, c: [
                {t: "column", w: 72, h: 72, radius: 36, bg: m_ter_cont,
                 alignx: 0.5, aligny: 0.5, c: [ icon(ic_user, 26, m_on_ter_cont) ]},
                txt(name, 22, 400, m_on_surface),
            ]},
            m_section("Books", rows),
        ]},
    ])
}

fn screen_navigation_and_routing_settings() {
    return page(m_surface, [
        m_appbar("Settings", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("Account", [ m_btn("Sign out", m_err_cont, m_error) ]),
            m_section("Navigation examples", [
                para("Example using the Link widget:", 14, 400, m_on_surf_var),
                m_btn_outlined("Go to /book/0"),
                para("Example using GoRouter.of(context).go():", 14, 400, m_on_surf_var),
                m_btn_outlined("Go to /authors"),
                para("Displays a dialog on the root Navigator:", 14, 400, m_on_surf_var),
                m_btn_outlined("Show Dialog"),
            ]),
        ]},
        nr_bottombar("Settings"),
    ])
}

fn screen_navigation_and_routing_signin() {
    return page(m_surface, [
        m_appbar("Sign in", "navigation_and_routing"),
        {t: "scroll", fillw: 1, pad: 24, spacing: 16, c: [
            txt("Sign in", 24, 400, m_on_surface),
            fa_field("Username", "Enter your username"),
            fa_field("Password", "Enter your password"),
            m_btn("Sign in", m_primary, m_on_primary),
            para("The sample gates every route behind this screen with a "
                + "redirect. There is no redirect here — no route table to "
                + "attach one to.", 13, 400, m_on_surf_var),
        ]},
    ])
}


// ---- pedometer.splash
// pedometer — flutter/samples/pedometer
fn screen_pedometer() {
    return na_screen("pedometer",
        "FFIgen and JNIgen: generating Dart bindings for Android Health Connect "
        + "and reading step counts through them, as a plugin plus example app.",
        [
            "Of its ~123k lines, ~91k are generated bindings and ~32k more are the Health Connect wrapper — the app itself is under 400 lines.",
            "The generated-bindings story has a direct Rust analogue (bindgen), but it is a build-time concern with nothing to draw.",
            "Reading step data needs a platform sensor API; the render pipeline has no capability surface at all.",
            "Splash-OH is where that half lives in this project — sensors, location and the rest of its 45 native capabilities.",
        ],
        "Not portable. The UI is a step counter; the sample is a binding generator.")
}


// ---- platform_channels.splash
// platform_channels — flutter/samples/platform_channels
fn screen_platform_channels() {
    return na_screen("platform_channels",
        "MethodChannel, EventChannel, BasicMessageChannel and custom "
        + "MessageCodecs — invoking platform methods, streaming values back, and "
        + "passing typed messages both ways.",
        [
            "The Dart half is a thin UI over channel calls; the substance is the Kotlin and Swift on the other side.",
            "There is no channel in the render pipeline. splash_render::build takes a `register` hook for injecting host functions, but nothing here installs one.",
            "The nearest thing this project has is Splash-OH's splash.invoke(tool, args) bridge — the same idea, already built, in the sibling repo.",
        ],
        "Not portable as a screen. The mechanism exists in this project; it lives in Splash-OH, not in the renderer.")
}


// ---- platform_design.splash
// platform_design — flutter/samples/platform_design
//
// "Adaptive Music App": the same four tabs (Songs, News, Profile, Settings)
// drawn with Material chrome on Android and Cupertino chrome on iOS. That
// side-by-side is the whole point of the sample, so both are here — the tab
// switches the chrome, exactly as the sample switches on defaultTargetPlatform.
//
// Songs and news headlines are randomly generated upstream (english_words +
// lorem). There is no RNG in the DSL and the host injects none, so these are
// fixed word pairs and the sample's real headline templates — same shape, no
// pretence of reproducing a seed.

// The sample's 11-colour Material pool (500 shades).
let pd_colors = [
    argb(255, 244,  67,  54), argb(255,  33, 150, 243), argb(255,   0, 150, 136),
    argb(255, 255, 235,  59), argb(255, 255, 193,   7), argb(255, 255,  87,  34),
    argb(255,  76, 175,  80), argb(255,  63,  81, 181), argb(255, 205, 220,  57),
    argb(255, 233,  30,  99), argb(255, 255, 152,   0),
]

let pd_songs = [
    "Silent Harbor", "Golden Thread", "Velvet Signal", "Copper Field",
    "Quiet Ember", "Marble Season", "Hollow Anchor", "Amber Circuit",
    "Paper Lantern", "Iron Meadow", "Static Bloom", "Cobalt Winter",
]

// The real headline templates from utils.dart, filled with fixed word pairs.
let pd_news = [
    ["Silent Harbor says gravity", "Rain drums under a low ceiling of cloud while the city keeps its own tempo."],
    ["Golden Thread releases Velvet Signal", "A second record arrives after three years of near total silence from the band."],
    ["Copper Field talks about their childhood", "Long interviews rarely go anywhere, but this one starts somewhere unusual."],
    ["Quiet Ember arrested due to paper lantern", "Details remain thin, and the label has so far declined to comment further."],
    ["Marble Season says the world needs more patience", "An unhurried argument, delivered from a folding chair in an empty venue."],
    ["Hollow Anchor calls their band luminous", "Naming things is the hardest part, they insist, and then prove the point."],
]

let pd_settings = [
    "Send me marketing emails",
    "Enable notifications",
    "Remind me to rate this app",
    "Background song refresh",
    "Recommend me songs based on my location",
    "Auto-transition playback to cast devices",
    "Find friends from my contact list",
]

// ---- Material (Android) chrome ---------------------------------------------

fn pd_mat_tabbar(active) {
    let items = [
        ["Songs", ic_music, "platform_design"],
        ["News", ic_news, "platform_design/news"],
        ["Profile", ic_user, "platform_design/profile"],
        ["Settings", ic_gear, "platform_design/settings"],
    ]
    let cells = []
    for it in items {
        let sel = it[0] == active
        let ink = pick_if(sel, m_on_sec_cont, m_on_surf_var)
        cells.push({t: "column", fillw: 1, h: 80, spacing: 4, alignx: 0.5, aligny: 0.5,
                    tapto: it[2], c: [
            {t: "column", w: 64, h: 32, radius: 16, alignx: 0.5, aligny: 0.5,
             bg: pick_if(sel, m_sec_cont, clear), c: [ icon(it[1], 15, ink) ]},
            txt(it[0], 12, 500, ink),
        ]})
    }
    return {t: "column", fillw: 1, bg: m_surf_cont, c: [
        rule(m_outline_var), {t: "row", fillw: 1, h: 80, c: cells},
    ]}
}

fn pd_mat_page(title, active, body_kids) {
    return page(m_surface, [
        m_appbar(title, "index"),
        {t: "scroll", fillw: 1, pad: 12, spacing: 12, c: body_kids},
        pd_mat_tabbar(active),
    ])
}

fn screen_platform_design() {
    let rows = []
    let i = 0
    for s in pd_songs {
        rows.push({t: "row", fillw: 1, fith: 1, pady: 8, spacing: 12,
                   aligny: 0.5, c: [
            {t: "column", w: 48, h: 48, radius: 8, bg: pd_colors[i % 11]},
            {t: "column", fillw: 1, fith: 1, spacing: 2, c: [
                para(s, 16, 400, m_on_surface),
                txt("Song " + (i + 1), 13, 400, m_on_surf_var),
            ]},
            icon(ic_play, 14, m_on_surf_var),
        ]})
        i = i + 1
    }
    return pd_mat_page("Songs", "Songs", rows)
}

fn screen_platform_design_news() {
    let cards = []
    let i = 0
    for n in pd_news {
        cards.push({t: "row", fillw: 1, radius: 4, bg: m_surf_low, elevation: 1.5,
                    pad: 12, spacing: 12, c: [
            {t: "column", w: 56, h: 56, radius: 4, bg: pd_colors[i % 11]},
            {t: "column", fillw: 1, fith: 1, spacing: 4, c: [
                para(n[0], 15, 500, m_on_surface),
                para(n[1], 13, 400, m_on_surf_var),
            ]},
        ]})
        i = i + 1
    }
    return pd_mat_page("News", "News", cards)
}

fn screen_platform_design_profile() {
    let intensity = ["Super heavy", "Dial it to 11", "Head bangin'", "1000W",
                     "My neighbor hates me"]
    let mood = ["Over the moon", "Basking in sunlight", "Hello fellow Martians",
                "Into the darkness"]
    let a = []
    for o in intensity { a.push(pd_opt_row(o, o == "Dial it to 11")) }
    let b = []
    for o in mood { b.push(pd_opt_row(o, o == "Over the moon")) }
    return pd_mat_page("Profile", "Profile", [
        {t: "column", fillw: 1, spacing: 8, alignx: 0.5, pady: 12, c: [
            {t: "column", w: 88, h: 88, radius: 44, bg: m_surf_highest,
             alignx: 0.5, aligny: 0.5, c: [ txt("😼", 44, 400, m_on_surface) ]},
        ]},
        m_section("MY INTENSITY PREFERENCE  🔥", a),
        m_section("CURRENT MOOD  🤘🏾🚀", b),
        m_btn("Log out", m_err_cont, m_error),
    ])
}

fn pd_opt_row(label, selected) {
    return {t: "row", fillw: 1, h: 40, spacing: 12, aligny: 0.5, c: [
        {t: "radio", on: pick_if(selected, 1, 0), w: 16, h: 16},
        txt(label, 14, 400, m_on_surface),
    ]}
}

fn screen_platform_design_settings() {
    let rows = []
    let i = 0
    for s in pd_settings {
        rows.push({t: "row", fillw: 1, fith: 1, pady: 8, spacing: 12,
                   aligny: 0.5, c: [
            {t: "column", fillw: 1, fith: 1, c: [ para(s, 14, 400, m_on_surface) ]},
            {t: "toggle", on: pick_if(i % 2 == 0, 1, 0), fitw: 1},
        ]})
        i = i + 1
    }
    return pd_mat_page("Settings", "Settings", [ m_section("Preferences", rows) ])
}

// ---- Cupertino (iOS) chrome -------------------------------------------------
// The same four tabs, drawn the way the sample draws them on iOS.

fn screen_platform_design_ios() {
    let rows = []
    let i = 0
    for s in pd_songs {
        if i > 0 { rows.push(rule(c_separator)) }
        rows.push({t: "row", fillw: 1, fith: 1, padx: 16, pady: 8, spacing: 12,
                   aligny: 0.5, c: [
            {t: "column", w: 44, h: 44, radius: 6, bg: pd_colors[i % 11]},
            {t: "column", fillw: 1, fith: 1, spacing: 2, c: [
                para(s, 17, 400, c_label),
                txt("Song " + (i + 1), 13, 400, c_label2),
            ]},
            icon(ic_fwd, 13, c_label2),
        ]})
        i = i + 1
    }
    return page(c_bg, [
        c_navbar("Songs — iOS chrome", "platform_design"),
        {t: "scroll", fillw: 1, bg: c_grouped, c: rows},
        {t: "column", fillw: 1, bg: c_grouped, c: [
            rule(c_separator),
            {t: "row", fillw: 1, h: 50, c: [
                pd_ios_tab("Songs", ic_music, 1), pd_ios_tab("News", ic_news, 0),
                pd_ios_tab("Profile", ic_user, 0), pd_ios_tab("Settings", ic_gear, 0),
            ]},
        ]},
    ])
}

fn pd_ios_tab(label, glyph, sel) {
    let ink = pick_if(sel == 1, c_blue, c_label2)
    return {t: "column", fillw: 1, h: 50, spacing: 2, alignx: 0.5, aligny: 0.5,
            c: [ icon(glyph, 17, ink), txt(label, 10, 400, ink) ]}
}


