// ---- date_planner.splash
// date_planner — flutter/samples/date_planner
//
// A Cupertino event planner: a large-title list grouped into the four Period
// buckets (Next 7 Days / Next 30 Days / Future / Past), each row a coloured
// rounded glyph tile plus title, tapping through to an event detail with its
// task checklist.
//
// All nine events from buildSampleData() are here with their real titles,
// ColorOptions tints, symbols and task lists; each sits in the bucket its
// FromNow.roundedHours offset puts it in.

// title, tint, glyph, when, bucket, route-key
let dp_events = [
    ["Pagliacci", c_yellow, ic_snow, "in 22 hours", "d7", "pagliacci"],
    ["Camping Trip", c_green, ic_leaf, "in 1 day", "d7", "camping"],
    ["Game Night", c_cyan, ic_game, "in 2 days", "d7", "game_night"],
    ["Doctor's Appointment", c_indigo, ic_flask, "in 4 days", "d7", "doctor"],
    ["Sayulita Trip", c_orange, ic_case, "in 19 days", "d30", "sayulita"],
    ["Maya's Birthday", c_red, ic_gift, "in 30 days", "d30", "maya"],
    ["First Day of School", c_label, ic_hammer, "in 1 year", "future", "school"],
    ["Book Launch", c_purple, ic_book, "in 2 years", "future", "book_launch"],
    ["WWDC", c_gray, ic_globe, "June 7, 2021", "past", "wwdc"],
]

let dp_tasks = [
    ["pagliacci", ["Buy new tux", "Get tickets",
                   "Pick up Carmen at the airport and bring her to the show"]],
    ["camping", ["Find a sleeping bag", "Bug spray", "Paper towels",
                 "Food for 4 meals", "Straw hat"]],
    ["game_night", ["Find a board game to bring", "Bring a desert to share"]],
    ["doctor", ["Bring medical ID", "Record heart rate data"]],
    ["sayulita", ["Buy plane tickets", "Get a new bathing suit", "Find a hotel room"]],
    ["maya", ["Guava kombucha", "Paper cups and plates", "Cheese plate",
              "Party poppers"]],
    ["school", ["Notebooks", "Pencils", "Binder", "First day of school outfit"]],
    ["book_launch", ["Finish first draft", "Send draft to editor",
                     "Final read-through"]],
    ["wwdc", ["Watch Keynote", "Watch What's new in SwiftUI",
              "Go to DT developer labs", "Learn about Create ML"]],
]

fn dp_bucket(bucket_key, header) {
    let rows = []
    let first = 1
    for e in dp_events {
        if e[4] == bucket_key {
            if first == 0 { rows.push(rule(c_separator)) }
            first = 0
            rows.push(c_iconrow(e[2], e[1], e[0], e[3], "date_planner/" + e[5]))
        }
    }
    if first == 1 { return {t: "column", h: 0} }
    return c_group(header, rows)
}

fn screen_date_planner() {
    return page(c_bg, [
        {t: "row", bg: c_grouped, fillw: 1, h: 44, padx: 12, aligny: 0.5, c: [
            {t: "row", fitw: 1, h: 44, padx: 4, spacing: 4, aligny: 0.5,
             tapto: "index", c: [
                icon(ic_back, 15, c_blue), txt("Samples", 17, 400, c_blue),
            ]},
            spacer(),
            icon(ic_plus, 16, c_blue),
        ]},
        c_largetitle("Date Planner"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 20, c: [
            dp_bucket("d7", "NEXT 7 DAYS"),
            dp_bucket("d30", "NEXT 30 DAYS"),
            dp_bucket("future", "FUTURE"),
            dp_bucket("past", "PAST"),
        ]},
    ])
}

// The event detail: symbol, title, date, then the Tasks checklist.
fn screen_date_planner_event(key) {
    let title = ""
    let tint = c_gray
    let glyph = ic_cal
    let when = ""
    for e in dp_events {
        if e[5] == key { title = e[0]; tint = e[1]; glyph = e[2]; when = e[3] }
    }
    let task_rows = []
    for t in dp_tasks {
        if t[0] == key {
            let first = 1
            for one in t[1] {
                if first == 0 { task_rows.push(rule(c_separator)) }
                first = 0
                task_rows.push({t: "row", fillw: 1, fith: 1, padx: 16, pady: 10,
                                spacing: 12, aligny: 0.5, c: [
                    {t: "checkbox", on: 0, w: 18, h: 18},
                    {t: "column", fillw: 1, fith: 1,
                     c: [ para(one, 17, 400, c_label) ]},
                ]})
            }
        }
    }
    task_rows.push(rule(c_separator))
    task_rows.push({t: "row", fillw: 1, h: 44, padx: 16, spacing: 10, aligny: 0.5, c: [
        icon(ic_plus, 14, c_blue),
        txt("Add task", 17, 400, c_blue),
    ]})

    return page(c_bg, [
        c_navbar("Date Planner", "date_planner"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 20, c: [
            {t: "column", fillw: 1, spacing: 10, alignx: 0.5, c: [
                {t: "column", w: 64, h: 64, radius: 15, bg: tint,
                 alignx: 0.5, aligny: 0.5, c: [ icon(glyph, 30, white) ]},
                para(title, 28, 500, c_label),
                txt(when, 15, 400, c_label2),
            ]},
            c_group("TASKS", task_rows),
        ]},
    ])
}


// ---- desktop_photo_search.splash
// desktop_photo_search — flutter/samples/desktop_photo_search
//
// A desktop Unsplash search, shipped twice from one model layer: once with
// Material widgets and once with fluent_ui. Both variants are here, because
// building the same app against two widget sets is the sample's whole point —
// and it is the same point this repo's themed kits make.
//
// The desktop split-pane shape ports: a search field, a result list, a detail
// pane with the photo's author and a download action.
//
// What does not port: the search itself. It is an HTTPS call to the Unsplash
// API keyed by an access token, deserialised through built_value, held in a
// ChangeNotifier and rendered as network images. The pipeline has no HTTP
// client and no async, and `src` on an image node would need a loader the host
// does not install. The tiles below are placeholders, not photos.

let dps_photos = [
    ["Mountain sunrise", "Ana Beltrán"],
    ["Harbour at dusk", "Tomás Ruiz"],
    ["Desert road", "Priya Nair"],
    ["Pine forest", "Karl Mensah"],
    ["City rooftops", "Lena Fischer"],
    ["Coastal cliffs", "Diego Alves"],
]

fn screen_desktop_photo_search() {
    return dps_variant("Material", 0)
}

fn screen_desktop_photo_search_fluent() {
    return dps_variant("fluent_ui", 1)
}

fn dps_variant(label, fluent) {
    // fluent_ui's surface is cooler and flatter than M3's.
    let bg      = pick_if(fluent == 1, pick(dk, argb(255, 32, 32, 32), argb(255, 243, 243, 243)), m_surface)
    let panel   = pick_if(fluent == 1, pick(dk, argb(255, 44, 44, 44), argb(255, 255, 255, 255)), m_surf_low)
    let ink     = pick_if(fluent == 1, pick(dk, white, argb(255, 26, 26, 26)), m_on_surface)
    let ink2    = pick_if(fluent == 1, pick(dk, argb(255, 170, 170, 170), argb(255, 96, 96, 96)), m_on_surf_var)
    let accent  = pick_if(fluent == 1, argb(255, 0, 120, 212), m_primary)
    let corner  = pick_if(fluent == 1, 4, 12)

    let tiles = []
    let i = 0
    for p in dps_photos {
        tiles.push({t: "row", fillw: 1, h: 84, radius: corner, bg: panel,
                    spacing: 12, c: [
            {t: "column", w: 110, fillh: 1, radius: corner, bg: pd_colors[i % 11]},
            {t: "column", fitw: 1, pady: 12, spacing: 4, c: [
                txt(p[0], 15, 500, ink),
                txt("by " + p[1], 12, 400, ink2),
            ]},
            spacer(),
            {t: "column", padx: 12, aligny: 0.5, c: [ icon(ic_file, 14, ink2) ]},
        ]})
        i = i + 1
    }

    let other = pick_if(fluent == 1, "desktop_photo_search", "desktop_photo_search/fluent")
    let other_label = pick_if(fluent == 1, "Show the Material variant",
                                           "Show the fluent_ui variant")

    return page(bg, [
        m_appbar("Photo Search — " + label, "index"),
        {t: "row", fillw: 1, padx: 16, pady: 12, spacing: 10, aligny: 0.5, c: [
            {t: "row", fillw: 1, h: 44, radius: corner, bg: panel, padx: 12,
             spacing: 8, aligny: 0.5, c: [
                icon(ic_search, 14, ink2),
                {t: "input", placeholder: "Search Unsplash", fillw: 1, fith: 1},
            ]},
            {t: "column", h: 44, radius: corner, bg: accent, padx: 20, fitw: 1,
             alignx: 0.5, aligny: 0.5, c: [ txt("Search", 14, 500, white) ]},
        ]},
        {t: "scroll", fillw: 1, padx: 16, spacing: 10, c: tiles},
        {t: "row", fillw: 1, padx: 16, pady: 12, c: [
            {t: "column", fillw: 1, tapto: other,
             c: [ m_btn_outlined(other_label) ]},
        ]},
    ])
}


// ---- docs.splash
// docs — flutter/samples/docs
//
// Not a UI port: this sample is configuration, tooling or prose. It states
// what the counterpart on this stack is rather than dismissing it.

fn screen_docs() {
    return counterpart_screen("docs",
        "The repository's own documentation — contribution notes and the architecture write-ups that accompany compass_app.",
        "This project documents itself in the same places: the repo READMEs, FLUTTER-SAMPLES.md on the ArkUI side, and a header comment at the top of every file in components/flutter explaining what that sample is and what it is not. The write-ups that matter here are the ones recording what was tried and failed — the shader that compiles and does not draw, the isolate seam — because those are the things a reader would otherwise have to rediscover.",
        ["Nothing renders. Prose is prose in both repos."])
}

// ---- dynamic_theme.splash
// dynamic_theme — flutter/samples/dynamic_theme
//
// "Flutter + GenAI": a Gemini chat where the model calls three declared
// functions to restyle the running app — change_theme_color (a 6-char hex),
// change_theme_mode (light/dark/system) and change_text_scale_factor.
//
// The chat surface ports, and so does the *effect*: the host already carries a
// dark flag, and re-mounting with it flipped restyles every screen — which is
// exactly what change_theme_mode does. The route below toggles it for real.
//
// What does not port is the model call. google_generative_ai needs an HTTPS
// client and a streaming response; the render pipeline has neither, so the
// transcript is a fixed exchange showing the three tool calls the sample
// declares.

let dt_messages = [
    [1, "Make the theme purple"],
    [0, "change_theme_color({ hex: \"6750A4\" }) → theme color updated"],
    [1, "Now switch to dark mode"],
    [0, "change_theme_mode({ mode: \"dark\" }) → theme mode updated"],
    [1, "Bump the text size a bit"],
    [0, "change_text_scale_factor({ scale: 1.3 }) → text scale updated"],
]

fn screen_dynamic_theme() {
    let bubbles = []
    for m in dt_messages {
        let mine = m[0] == 1
        // The bubble must FILL its share of the row: a `fillw` paragraph inside
        // a `fitw` column is degenerate — Fill resolving against Fit collapsed
        // every bubble to a one-pixel sliver. A fixed-width gutter on the
        // opposite side gives the incoming/outgoing offset instead.
        let bubble = {t: "column", fillw: 1, fith: 1, radius: 16, pad: 12,
                      bg: pick_if(mine, m_pri_cont, m_surf_highest), c: [
            para(m[1], 14, 400, pick_if(mine, m_on_pri_cont, m_on_surface)),
        ]}
        let gutter = {t: "column", w: 56, h: 1}
        let cells = []
        if mine { cells.push(gutter); cells.push(bubble) }
        else { cells.push(bubble); cells.push(gutter) }
        bubbles.push({t: "row", fillw: 1, fith: 1, c: cells})
    }
    return page(m_surface, [
        m_appbar("Flutter + GenAI", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("API key", [
                {t: "row", fillw: 1, h: 56, radius: 4, bg: m_surf_highest,
                 padx: 16, spacing: 8, aligny: 0.5, c: [
                    {t: "input", placeholder: "Enter your API key", fillw: 1, fith: 1},
                ]},
                m_btn("Submit", m_primary, m_on_primary),
            ]),
            m_section("Transcript", bubbles),
            m_section("Declared functions", [
                dt_fn("change_theme_color", "hex — 6 characters, e.g. FF00EE"),
                dt_fn("change_theme_mode", "mode — light | dark | system"),
                dt_fn("change_text_scale_factor", "scale — 1.0 is 14px, 2.0 is 48px"),
            ]),
            m_section("This one is real", [
                para("change_theme_mode is the one tool call that works here: the "
                    + "host carries the dark flag and every screen re-reads it on "
                    + "mount.", 13, 400, m_on_surf_var),
                {t: "column", fillw: 1, tapto: "theme:toggle",
                 c: [ m_btn("Toggle theme mode", m_sec_cont, m_on_sec_cont) ]},
            ]),
        ]},
        // The prompt bar.
        {t: "row", fillw: 1, bg: m_surf_cont, padx: 16, pady: 12, spacing: 10,
         aligny: 0.5, c: [
            {t: "column", fillw: 1, h: 48, radius: 24, bg: m_surf_highest,
             padx: 16, aligny: 0.5,
             c: [ {t: "input", placeholder: "Ask Gemini…", fillw: 1, fith: 1} ]},
            {t: "column", w: 48, h: 48, radius: 24, bg: m_primary,
             alignx: 0.5, aligny: 0.5, c: [ icon(ic_bolt, 16, m_on_primary) ]},
        ]},
    ])
}

fn dt_fn(name, arg) {
    return {t: "column", fillw: 1, radius: 8, bg: m_surface, border: 1,
            bordercolor: m_outline_var, pad: 12, spacing: 2, c: [
        txt(name, 14, 500, m_primary),
        txt(arg, 12, 400, m_on_surf_var),
    ]}
}


// ---- form_app.splash
// form_app — flutter/samples/form_app
//
// Four form demos behind an index: Sign in with HTTP, Autofill, Form widgets,
// Validation. All four screens are here with the sample's real field labels,
// hints and validation messages.
//
// What does not port: the *behaviour*. TextEditingController, FormState,
// validators and the mock HTTP client all need per-field state and a submit
// path the static renderer has no vocabulary for, so the error strings are
// shown in place rather than triggered.

let fa_demos = [
    ["Sign in with HTTP", "signin_http"],
    ["Autofill", "autofill"],
    ["Form widgets", "form_widgets"],
    ["Validation", "validation"],
]

fn screen_form_app() {
    let rows = []
    for d in fa_demos { rows.push(m_navrow(d[0], "form_app/" + d[1])) }
    return page(m_surface, [
        m_appbar("Form Samples", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16,
         c: [ m_section("Demos", rows) ]},
    ])
}

// An M3 outlined text field with a floating label.
fn fa_field(label, hint) {
    return {t: "column", fillw: 1, spacing: 4, c: [
        txt(label, 12, 400, m_primary),
        {t: "column", fillw: 1, h: 56, radius: 4, bg: m_surface, border: 1,
         bordercolor: m_outline, padx: 16, aligny: 0.5,
         c: [ {t: "input", placeholder: hint, fillw: 1, fith: 1} ]},
    ]}
}

// The same field in its error state, with the sample's real message.
fn fa_field_err(label, hint, err) {
    return {t: "column", fillw: 1, spacing: 4, c: [
        txt(label, 12, 400, m_error),
        {t: "column", fillw: 1, h: 56, radius: 4, bg: m_surface, border: 2,
         bordercolor: m_error, padx: 16, aligny: 0.5,
         c: [ {t: "input", placeholder: hint, fillw: 1, fith: 1} ]},
        txt(err, 12, 400, m_error),
    ]}
}

fn screen_form_app_signin_http() {
    return page(m_surface, [
        m_appbar("Sign in with HTTP", "form_app"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("Credentials", [
                fa_field("Username", "Enter your username"),
                fa_field("Password", "Enter your password"),
                m_btn("Sign in", m_primary, m_on_primary),
            ]),
            m_section("Not ported", [
                para("The submit posts to a mock http.Client and swaps the button "
                    + "for a progress indicator while it is in flight. There is no "
                    + "async or HTTP in the render pipeline, so the button is inert.", 13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

fn screen_form_app_autofill() {
    return page(m_surface, [
        m_appbar("Autofill", "form_app"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("AutofillGroup", [
                fa_field("Name", "Enter your name"),
                fa_field("Phone number", "Enter your phone number"),
                fa_field("Email", "Enter your email address"),
                fa_field("Street address", "Enter your street address"),
                m_btn("Submit", m_primary, m_on_primary),
            ]),
            m_section("Not ported", [
                para("Autofill hints are a platform-keyboard contract. makepad's "
                    + "TextInput exposes no autofill hint, so the grouping is "
                    + "presentational here.", 13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

fn screen_form_app_form_widgets() {
    return page(m_surface, [
        m_appbar("Form widgets", "form_app"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("Fields", [
                fa_field("Title", "Enter a title..."),
                fa_field("Description", "Enter a description..."),
            ]),
            m_section("Date", [
                {t: "row", fillw: 1, h: 48, spacing: 12, aligny: 0.5, c: [
                    txt("Date", 16, 400, m_on_surface),
                    spacer(),
                    txt("Jan 1, 2024", 14, 400, m_on_surf_var),
                    m_btn_outlined("Edit"),
                ]},
            ]),
            m_section("Slider", [
                {t: "slider", value: 0.5, fillw: 1, h: 32},
                txt("Max value", 13, 400, m_on_surf_var),
            ]),
            m_section("Checkbox", [
                check_row("Brushed teeth", 1),
            ]),
            m_section("Switch", [
                {t: "row", fillw: 1, h: 40, spacing: 12, aligny: 0.5, c: [
                    txt("Enable feature", 14, 400, m_on_surface),
                    spacer(),
                    {t: "toggle", on: 1, w: 52, h: 32},
                ]},
            ]),
        ]},
