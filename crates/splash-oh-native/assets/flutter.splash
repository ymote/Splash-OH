// segmented_control_page.dart / sliding_segmented_control_page.dart:
// One / Two / Three, first selected. Both are 28 tall.
fn cg_segments(sliding) {
    let segs = ["One", "Two", "Three"]
    let cells = []
    let i = 0
    for s in segs {
        let sel = i == 0
        let bg = pick_if(sel, pick_if(sliding == 1, c_grouped, c_blue), clear)
        let ink = pick_if(sel && sliding == 0, white, c_label)
        cells.push({t: "column", fillw: 1, h: 28, radius: 7, alignx: 0.5,
                    aligny: 0.5, bg: bg, c: [ txt(s, 13, 500, ink) ]})
        i = i + 1
    }
    return cells
}

fn screen_cg_segmented() {
    return cg_detail("Segmented Control", [
        {t: "row", fillw: 1, h: 32, radius: 7, border: 1, bordercolor: c_blue,
         pad: 2, c: cg_segments(0)},
    ])
}

fn screen_cg_sliding() {
    return cg_detail("Sliding Segmented Control", [
        {t: "row", fillw: 1, h: 32, radius: 8, bg: c_fill, pad: 2,
         c: cg_segments(1)},
        cg_note("The thumb slides between segments under the finger. The static "
                + "control is what the DSL can express; the sliding needs an "
                + "animation it has no vocabulary for."),
    ])
}

