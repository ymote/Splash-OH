let ic_check   = "\u{f00c}"
let ic_image   = "\u{f03e}"
let ic_bolt    = "\u{f0e7}"
let ic_map     = "\u{f279}"
let ic_phone   = "\u{f3cd}"
let ic_cube    = "\u{f1b2}"
let ic_code    = "\u{f121}"
let ic_flask2  = "\u{f0c3}"
let ic_ban     = "\u{f05e}"
let ic_wrench  = "\u{f0ad}"
let ic_globe   = "\u{f0ac}"
let ic_layer   = "\u{f5fd}"
let ic_paint   = "\u{f1fc}"
let ic_shoe    = "\u{f54b}"
let ic_bell    = "\u{f0f3}"
let ic_clock   = "\u{f017}"
let ic_cal     = "\u{f133}"
let ic_case    = "\u{f0b1}"
let ic_pin     = "\u{f3c5}"
let ic_play    = "\u{f04b}"
let ic_walk    = "\u{f554}"
let ic_droid   = "\u{f17b}"
let ic_apple   = "\u{f179}"
let ic_swift   = "\u{f81a}"
let ic_file    = "\u{f15b}"
let ic_flag    = "\u{f024}"
let ic_compass = "\u{f14e}"

// ---- generic building blocks -----------------------------------------------

// A single line of text.
//
// Carries no height, for the same reason `para` carries none: makepad clips a
// Label to its box, and a hand-picked height even slightly under the font's line
// box shears the descenders off — at 28sp in a 36px box the "p" in "samples"
// lost its tail. `fith` makes the Label report the height its own glyphs need.
// Vertical spacing belongs to the parent's `spacing`/`pad`, not to padded-out
// text boxes.
fn txt(s, size, weight, color) {
    return {t: "text", text: s, size: size, weight: weight, color: color,
            fith: 1}
}

// A paragraph that wraps.
//
// A makepad Label only wraps when it has a width to wrap inside; with none it
// lays out on one line and runs off the edge, so `fillw` gives it the parent's
// width. It takes no height on purpose: how many lines the text breaks into
// depends on the width it lands at, which the author cannot know, and every
// fixed height guessed here clipped the last line on a 1080px phone. `fith`
// makes the Label measure its own wrapped text instead.
fn para(s, size, weight, color) {
    return {t: "text", text: s, size: size, weight: weight, color: color,
            fillw: 1, fith: 1}
}

// A glyph from the theme's Font-Awesome face. Same self-measuring rule as `txt`.
fn icon(cp, size, color) {
    return {t: "text", text: cp, icon: 1, size: size, color: color,
            fitw: 1, fith: 1}
}

// ---- animation -------------------------------------------------------------
//
// `st.t` is seconds since the host started. The DSL has no tween, curve or
// controller, and a tree is evaluated once per mount — so the only way anything
// moves is for the host to re-mount against a changing clock and for the screen
// to compute its own values from it. These are the curves Flutter's
// `AnimationController`/`Curves` would otherwise supply.

// Fractional part, i.e. a 0..1 sawtooth of the given period.
fn phase(period) {
    let x = st.t / period
    return x - floorn(x)
}
fn floorn(x) {
    let i = x - (x % 1.0)
    if x < 0.0 && (x % 1.0) != 0.0 { return i - 1.0 }
    return i
}
// 0 -> 1 -> 0, the shape Curves.easeInOut gives a repeating controller.
fn pingpong(period) {
    let p = phase(period)
    if p < 0.5 { return p * 2.0 }
    return (1.0 - p) * 2.0
}
// Linear interpolation, Flutter's Tween<double>.
fn lerp(a, b, t) { return a + (b - a) * t }
// Cubic ease-in-out, the default Curves.easeInOut shape.
fn ease(t) {
    if t < 0.5 { return 4.0 * t * t * t }
    let f = 0.0 - 2.0 * t + 2.0
    return 1.0 - (f * f * f) / 2.0
}
// The rest of the Curves the animation sample actually names.
fn ease_in_cubic(t) { return t * t * t }
fn ease_out_cubic(t) { let f = 1.0 - t  return 1.0 - f * f * f }
fn ease_in_expo(t) {
    if t <= 0.0 { return 0.0 }
    return pow2(10.0 * t - 10.0)
}
fn ease_out_expo(t) {
    if t >= 1.0 { return 1.0 }
    return 1.0 - pow2(0.0 - 10.0 * t)
}
// 2^x for the exponential curves, by squaring — the VM has no pow.
fn pow2(x) {
    let r = 1.0
    let n = floorn(x)
    let i = 0
    while i < n { r = r * 2.0  i = i + 1 }
    while i > n { r = r / 2.0  i = i - 1 }
    let f = x - n
    // linear inside the octave is close enough at these sizes
    return r * (1.0 + f)
}
// Curves.bounceOut, transcribed from Flutter's own piecewise definition.
fn bounce_out(t) {
    if t < 0.363636 { return 7.5625 * t * t }
    if t < 0.727272 {
        let u = t - 0.545454
        return 7.5625 * u * u + 0.75
    }
    if t < 0.909090 {
        let u = t - 0.818181
        return 7.5625 * u * u + 0.9375
    }
    let u = t - 0.954545
    return 7.5625 * u * u + 0.984375
}
fn bounce_in(t) { return 1.0 - bounce_out(1.0 - t) }
// A damped spring settling on 1.0 — the shape SpringDescription gives.
fn spring(t) {
    if t >= 1.0 { return 1.0 }
    let decay = 1.0 - t
    return 1.0 - decay * decay * cos_approx(t * 18.0)
}
// Cosine by its series; the VM has no trig.
fn cos_approx(x) {
    let tau = 6.2831853
    let n = floorn(x / tau)
    let a = x - n * tau
    if a > 3.1415927 { a = tau - a }
    let a2 = a * a
    return 1.0 - a2 / 2.0 + (a2 * a2) / 24.0 - (a2 * a2 * a2) / 720.0
}
// Scale a colour's alpha — the DSL's stand-in for opacity, since neither a
// makepad View nor the translator carries one. Text and fills both take it.
fn fade(color, alpha) {
    let a = floorn(chan(color, 16777216) * alpha)
    return argb(a, chan(color, 65536), chan(color, 256), chan(color, 1))
}
// Interpolate a colour channelwise — Flutter's ColorTween.
// Every step here has to be floored. `/` in this VM is float division, so
// `(c / 65536) % 256` yields a fraction, argb() then builds a non-integer colour
// word, and the cast to u32 lands on garbage — which is why the animated
// container rendered flat white instead of a blend.
fn chan(c, shift) { return floorn(floorn(c / shift) % 256) }
fn lerp_argb(c1, c2, t) {
    return argb(floorn(lerp(chan(c1, 16777216), chan(c2, 16777216), t)),
                floorn(lerp(chan(c1, 65536),    chan(c2, 65536),    t)),
                floorn(lerp(chan(c1, 256),      chan(c2, 256),      t)),
                floorn(lerp(chan(c1, 1),        chan(c2, 1),        t)))
}

// ---- the arithmetic a distance function needs -------------------------------
// The VM has no sqrt, min, sign or smoothstep. A signed distance field is just
// arithmetic, so with these the DSL can evaluate one per cell and draw it with
// ordinary nodes — no fragment shader, and it works on both backends.
fn absn(x) { if x < 0.0 { return 0.0 - x }  return x }
fn minn(a, b) { if a < b { return a } return b }
fn maxn(a, b) { if a > b { return a } return b }
fn signn(x) { if x < 0.0 { return 0.0 - 1.0 }  if x > 0.0 { return 1.0 }  return 0.0 }
fn sqrtn(x) {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    if g > 1.0 { g = x / 2.0 } else { g = 1.0 }
    let mut i = 0
    while i < 20 { g = (g + x / g) / 2.0  i = i + 1 }
    return g
}
fn smoothstepn(e0, e1, x) {
    let mut t = (x - e0) / (e1 - e0)
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    return t * t * (3.0 - 2.0 * t)
}

fn gap(px) { return {t: "column", h: px} }

fn spacer() { return {t: "column", fillw: 1, h: 1} }

// A horizontal rule.
fn rule(color) { return {t: "column", h: 1, bg: color, fillw: 1} }

// A page root: full width, background painted, content stacked down.
//
// Deliberately does NOT set `fillh`. The host mounts the kit into
// `Splash{ height: Fit }`, so a root asking for `height: Fill` resolves against
// a Fit parent and collapses to nothing — every screen renders blank. The
// enclosing ScrollYView in the host provides the scrolling instead. Same reason
// the scroll bodies below are width-fill and height-fit.
fn page(bg_color, kids) {
    // The routing signal has to live INSIDE the mounted tree.
    //
    // Upstream's `Splash` mounts on an isolate VM, and makepad injects `ui` into
    // that VM resolved against *the splash's own view root* (see
    // `inject_splash_ui_handle` in widgets/src/widget_async.rs, which returns
    // early for the main VM). So a `tapto` handler's `ui.nav_signal` can only
    // ever see widgets inside the mounted subtree — the host's own nav_signal
    // Label, a sibling of the Splash widget, is invisible to it. Every tap was
    // silently dropped until this label moved in here. The host's widget search
    // does descend into the mounted tree, so it still reads it.
    //
    // When the `isolate: false` upstream PR lands this stays correct; it just
    // stops being load-bearing.
    let c = [ {t: "text", id: "nav_signal", text: "", size: 1, h: 1, color: bg_color} ]
    for k in kids { c.push(k) }
    return {t: "column", bg: bg_color, fillw: 1, c: c}
}

// ---- Material chrome --------------------------------------------------------

// An M3 top app bar with a back chevron routed to `back_route`.
// Fit height with a wrapping title: a fixed 64px bar clipped the longer titles
// ("Photo Search — Material") to their first line and cut the rest off.
fn m_appbar(title, back_route) {
    return {t: "row", bg: m_surf_cont, fillw: 1, h: 56, padx: 8,
            spacing: 8, aligny: 0.5, c: [
        {t: "column", w: 48, h: 48, radius: 24, alignx: 0.5, aligny: 0.5,
         tapto: back_route, c: [ icon(ic_back, 16, m_on_surface) ]},
        {t: "column", fillw: 1, fith: 1, c: [ para(title, 22, 400, m_on_surface) ]},
    ]}
}

// A titled grouping card (surfaceContainerLow, 12dp corner) — M3 Title Medium.
// The title wraps: several are long enough to run off a phone on one line.
fn m_section(title, kids) {
    let c = [ para(title, 16, 500, m_on_surface) ]
    for k in kids { c.push(k) }
    return {t: "column", bg: m_surf_low, radius: 12, pad: 16, spacing: 12, c: c}
}

// M3 common buttons — 40dp tall, full corner, 24dp/6dp insets, Label Large.
fn m_btn(label, fill, ink) {
    return {t: "column", bg: fill, radius: 20, h: 40, padx: 24, fitw: 1,
            alignx: 0.5, aligny: 0.5, c: [ txt(label, 14, 500, ink) ]}
}
// A full-width filled button — the sample's primary call to action, which
// `m_btn` (content-sized, for button rows) renders as a small chip.
fn m_btn_wide(label, fill, ink) {
    return {t: "column", bg: fill, radius: 20, h: 40, padx: 24,
            fillw: 1, alignx: 0.5, aligny: 0.5,
            c: [ txt(label, 14, 500, ink) ]}
}

fn m_btn_outlined(label) {
    return {t: "column", bg: m_surface, border: 1, bordercolor: m_outline, radius: 20,
            h: 40, padx: 24, fitw: 1, alignx: 0.5, aligny: 0.5,
            c: [ txt(label, 14, 500, m_primary) ]}
}
fn m_btn_text(label) {
    return {t: "column", radius: 20, h: 40, padx: 12, pady: 8, fitw: 1,
            alignx: 0.5, aligny: 0.5, c: [ txt(label, 14, 500, m_primary) ]}
}

// A tappable full-width M3 list row with a trailing chevron.
fn m_navrow(label, route) {
    return {t: "row", fillw: 1, h: 56, padx: 16, bg: m_surface, tapto: route, c: [
        txt(label, 16, 400, m_on_surface),
        spacer(),
        icon(ic_fwd, 12, m_on_surf_var),
    ]}
}

// An M3 card with elevation.
fn m_card(elev, kids) {
    return {t: "column", bg: m_surf_low, radius: 12, elevation: elev, pad: 16,
            spacing: 8, c: kids}
}

// ---- Cupertino chrome -------------------------------------------------------

// An iOS nav bar: back chevron + title, hairline separator underneath.
fn c_navbar(title, back_route) {
    return {t: "column", fillw: 1, c: [
        {t: "row", bg: c_grouped, fillw: 1, h: 44, padx: 16,
         spacing: 6, aligny: 0.5, c: [
            {t: "row", fitw: 1, h: 44, padx: 4, spacing: 4, aligny: 0.5,
             tapto: back_route, c: [
                icon(ic_back, 15, c_blue),
                txt("Back", 17, 400, c_blue),
            ]},
            // The title wraps rather than truncating — "Sliding Segmented
            // Control" does not fit a phone width on one line.
            {t: "column", fillw: 1, fith: 1, alignx: 0.5,
             c: [ para(title, 17, 500, c_label) ]},
            {t: "column", w: 56, h: 1},
        ]},
        rule(c_separator),
    ]}
}

// An iOS large-title header (CupertinoSliverNavigationBar collapsed state).
fn c_largetitle(title) {
    return {t: "column", bg: c_grouped, fillw: 1, padx: 16, pady: 8, c: [
        txt(title, 34, 500, c_label),
    ]}
}

// A grouped-list section: uppercase header + rounded white card of rows.
fn c_group(header, rows) {
    let kids = []
    if header != "" {
        kids.push({t: "column", padx: 16, pady: 6, c: [
            txt(header, 13, 400, c_label2),
        ]})
    }
    kids.push({t: "column", bg: c_grouped, radius: 10, fillw: 1, c: rows})
    // _kMarginTop = 22 (cupertino/list_section.dart:18).
    return {t: "column", fillw: 1, pady: 22, c: kids}
}

// One row inside a grouped list, with an optional trailing chevron.
fn c_row(label, trailing, chev, route) {
    let right = []
    if trailing != "" { right.push(txt(trailing, 17, 400, c_label2)) }
    if chev == 1 { right.push(icon(ic_fwd, 13, c_label2)) }
    let c = [ txt(label, 17, 400, c_label), spacer() ]
    for r in right { c.push(r) }
    return {t: "row", fillw: 1, h: 44, padx: 16, spacing: 8, tapto: route, c: c}
}

// A row led by a rounded colour tile carrying a glyph — date_planner's event row.
// Height is Fit with vertical padding rather than a fixed 56: a fixed row height
// clipped the second line off every subtitle once the labels measured their own
// glyphs. Same rule as the text helpers — let the content say how tall it is.
fn c_iconrow(glyph, tint, title, subtitle, route) {
    let text_col = [ txt(title, 16, 400, c_label) ]
    if subtitle != "" { text_col.push(txt(subtitle, 14, 400, c_label2)) }
    return {t: "row", fillw: 1, fith: 1, padx: 16, pady: 12, spacing: 12,
            aligny: 0.5, tapto: route, c: [
        {t: "column", w: 30, h: 30, radius: 7, bg: tint, alignx: 0.5, aligny: 0.5,
         c: [ icon(glyph, 14, white) ]},
        {t: "column", fillw: 1, fith: 1, spacing: 3, c: text_col},
        icon(ic_fwd, 13, c_label2),
    ]}
}

// ---- an iOS picker wheel, drawn ---------------------------------------------
//
// makepad ships no date, time or value picker — `widgets/src` has DropDown and
// PopupMenu and nothing wheel-shaped — so `{t:"datepicker"}` and friends fall
// through the translator's match to a bare `View` and render as an empty white
// box. The DSL also has no attribute for a picker's items, so there is nothing
// to hand a native widget even if one existed.
//
// These screens therefore draw the wheel out of the primitives that do work: a
// column of values with the selection band behind the middle row and the
// neighbours dimmed. It is a picture of a picker, not a picker — it does not
// spin — and the Cupertino Gallery pages say so.
fn c_wheel(cols, sel_index) {
    let lanes = []
    for col in cols {
        let rows = []
        let i = 0
        for v in col {
            let d = i - sel_index
            let shade = pick_if(d == 0, c_label, c_label2)
            rows.push({t: "column", fillw: 1, h: 34, alignx: 0.5, aligny: 0.5,
                       c: [ txt(v, 18, 400, shade) ]})
            i = i + 1
        }
        lanes.push({t: "column", fillw: 1, c: rows})
    }
    return {t: "stack", fillw: 1, h: 180, c: [
        // The selection band sits behind the middle lane row.
        {t: "column", fillw: 1, h: 180, aligny: 0.5, c: [
            {t: "column", fillw: 1, h: 34, radius: 8, bg: c_fill},
        ]},
        {t: "row", fillw: 1, h: 180, aligny: 0.5, c: lanes},
    ]}
}

// ---- the platform-counterpart screen ---------------------------------------
//
// Replaces the old "No Splash+makepad analogue" banner. That framing was wrong
// more often than it was right — six samples carrying it turned out to have
// real counterparts here, each time because the note judged what the makepad
// DSL could express rather than what this stack has.
//
// So a sample that is not a UI port now says three things instead of one: what
// it teaches, what this stack's counterpart is, and what genuinely has no
// equivalent. The third list is usually short and specific.

fn counterpart_screen(title, teaches, counterpart, missing) {
    let gaps = []
    for m in missing {
        gaps.push({t: "row", fillw: 1, fith: 1, spacing: 8, aligny: 0.0, c: [
            txt("\u{2014}", 14, 400, m_on_surf_var),
            {t: "column", fillw: 1, fith: 1, c: [ para(m, 14, 400, m_on_surf_var) ]},
        ]})
    }
    return page(m_surface, [
        m_appbar(title, "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("What the Flutter sample teaches", [
                para(teaches, 14, 400, m_on_surf_var),
            ]),
            m_section("The counterpart here", [
                para(counterpart, 14, 400, m_on_surface),
            ]),
            m_section("What has no equivalent", gaps),
        ]},
    ])
}

// ---- add_to_app.splash
// add_to_app — flutter/samples/add_to_app
//
// Previously "no analogue": six Android/iOS host apps embedding a Flutter
// module, mostly Kotlin, Swift and Gradle, with no FlutterEngine equivalent
// here.
//
// The mistake was reading it as a sample about Flutter's embedding API rather
// than about the shape of the problem. This app *is* add-to-app, inverted: an
// ArkTS shell hands Rust exactly one NodeContent at startup, and every node
// after that is created, configured, laid out and event-wired from Rust with no
// per-widget and no per-frame ArkTS call.
//
// So rather than describe someone else's embed, this screen reports on its own.

fn screen_add_to_app() {
    return page(m_surface, [
        m_appbar("Add to App", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("This screen is the embed", [
                {t: "column", fillw: 1, bg: m_surf_lowest, radius: 8, pad: 12,
                 spacing: 4, c: [
                    txt("native nodes built from Rust", 13, 500, m_primary),
                    para(invoke("embed.nodes"), 22, 500, m_on_surface),
                ]},
                para(invoke("embed.shape"), 13, 400, m_on_surf_var),
            ]),
            m_section("Same problem, opposite direction", [
                para("Flutter's samples embed a Flutter module into a host that "
                     + "owns the app. Here the host owns the app and hands over "
                     + "a single surface, and the guest builds native widgets of "
                     + "the host's own toolkit rather than painting its own.",
                     13, 400, m_on_surf_var),
                para("What has no counterpart: FlutterEngine, an engine cache, "
                     + "multiple simultaneous engines, and the prebuilt "
                     + "AAR/framework packaging that is most of the sample.",
                     13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

// ---- analysis_defaults.splash
// analysis_defaults — flutter/samples/analysis_defaults
//
// Not a UI port: this sample is configuration, tooling or prose. It states
// what the counterpart on this stack is rather than dismissing it.

fn screen_analysis_defaults() {
    return counterpart_screen("Analysis Defaults",
        "One shared analysis_options.yaml that every sample in the repo includes, so lint rules are set once for the whole repository.",
        "The same idea, one layer down: a Cargo workspace with shared lints, rustfmt.toml, and clippy run over every crate at once. `cargo test --workspace` is the equivalent of including the shared config everywhere — the settings live in one place and no crate opts out.",
        ["Dart's analyzer has no counterpart; rustc and clippy are the compiler, not a separate tool a project can swap.",
         "There is nothing to draw either way. This directory is configuration in both repos."])
}

// ---- android_splash_screen.splash
// android_splash_screen — flutter/samples/android_splash_screen
//
// Not a UI port: this sample is configuration, tooling or prose. It states
// what the counterpart on this stack is rather than dismissing it.

fn screen_android_splash_screen() {
    return counterpart_screen("Android Splash Screen",
        "Android 12's SplashScreen API with Flutter: an animated launch icon that hands off smoothly to the first Flutter frame.",
        "OpenHarmony has the same seam. The system draws the app's launch window from the ability's configuration before any Rust runs, and the first native tree is mounted after `onCreate` hands over a NodeContent. The handoff this sample is careful about — system art, then the app's first frame — happens here too; it is configured in module.json5 rather than drawn.",
        ["No animated launch icon is configured in this app, so there is nothing to show beyond the default.",
         "Android's `windowSplashScreenAnimatedIcon` and the exit-animation callback have no OpenHarmony equivalent this project uses."])
}

// ---- animations.splash
// animations — flutter/samples/animations
//
// The Flutter sample is a go_router index of 20 animation demos split into
// Basics and Misc, each pushing a self-contained screen.
//
// The index and all 20 titles port exactly. The demos themselves do not: the
// Splash DSL has no animation vocabulary — no tweens, curves, controllers or
// implicit transitions — so each demo screen shows a still frame of what it
// animates plus a note naming the missing primitive. Two of the twenty *are*
// live, because makepad's own widgets animate them in their shaders: the
// circular spinner and the M3 shape-morph indicator.

let an_basics = [
    ["AnimatedContainer", "animated_container", "A container tweens size, colour and corner radius on each tap."],
    ["PageRouteBuilder", "page_route", "A custom route transition drives a Tween across a page push."],
    ["Animation Controller", "controller", "A raw AnimationController drives a value from 0 to 1 and back."],
    ["Tweens", "tweens", "A Tween maps the controller's 0..1 onto a range of values."],
    ["AnimatedBuilder", "animated_builder", "AnimatedBuilder rebuilds only the subtree that depends on the value."],
    ["Custom Tween", "custom_tween", "A Tween subclass interpolates a non-numeric type."],
    ["Tween Sequences", "tween_sequence", "TweenSequence chains weighted tweens into one timeline."],
    ["Fade Transition", "fade_transition", "FadeTransition drives opacity from an animation."],
]

let an_misc = [
    ["Expandable Card", "expand_card", "A card grows to fill the screen when tapped."],
    ["Carousel", "carousel", "A page-view carousel with a scaled, parallaxed centre item."],
    ["Focus Image", "focus_image", "An image scales up under a long-press and settles back."],
    ["Card Swipe", "card_swipe", "Cards are dismissed with a horizontal drag and a fling."],
    ["Flutter Animate", "flutter_animate", "The flutter_animate package composes effects in a chain."],
    ["Repeating Animation", "repeating", "A controller repeats forever, driving a pulsing scale."],
    ["Spring Physics", "spring", "A physics simulation springs a card back to centre."],
    ["AnimatedList", "animated_list", "Rows animate in and out as the backing list changes."],
    ["AnimatedPositioned", "animated_positioned", "A Positioned child tweens to new offsets inside a Stack."],
    ["AnimatedSwitcher", "animated_switcher", "One child cross-fades to another as the key changes."],
    ["Hero Animation", "hero", "A Hero flies its child between two routes."],
    ["Curved Animation", "curved", "A CurvedAnimation reshapes the controller's linear ramp."],
]

fn an_group(header, items) {
    let rows = []
    for it in items { rows.push(m_navrow(it[0], "animations/" + it[1])) }
    return m_section(header, rows)
}

fn screen_animations() {
    return page(m_surface, [
        m_appbar("Animation Samples", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            an_group("Basics", an_basics),
            an_group("Misc", an_misc),
        ]},
    ])
}

// One demo screen. These now actually move.
//
// `st.t` is a clock the host advances while an animations route is on screen;
// the tree is recomputed against it every frame. That is the only animation
// this design admits — there is no tween, curve or controller in the DSL — so
// the curves live in `_kit.splash` and each demo computes its own frame.
fn screen_animations_demo(key) {
    let title = ""
    let blurb = ""
    for it in an_basics { if it[1] == key { title = it[0]; blurb = it[2] } }
    for it in an_misc { if it[1] == key { title = it[0]; blurb = it[2] } }

    let stage = an_stage(key)
    return page(m_surface, [
        m_appbar(title, "animations"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("What it demonstrates", [
                para(blurb, 14, 400, m_on_surf_var),
            ]),
            {t: "column", bg: m_surf_low, radius: 12, pad: 24, spacing: 16,
             fillw: 1, alignx: 0.5, c: stage},
        ]},
    ])
}

// A live frame for each demo, computed from the clock.
//
// One branch per demo, with the sample's own duration and values — 400ms for
// AnimatedContainer, 800ms and deepPurple->deepOrange for AnimatedBuilder, 3s
// for the typewriter and the rainbow, 2s and radius 100->0 for the repeat, 4s
// for the curve comparison. Nothing is shared between them; each is the effect
// its own demo file describes.

// The lorem the TypewriterTween types out, in chunks so it can be revealed
// progressively — the VM has no substring.
let an_typed = ["Lorem ", "ipsum ", "dolor ", "sit ", "amet, ", "consectetur ",
                "adipiscing ", "elit, ", "sed ", "do ", "eiusmod ", "tempor ",
                "incididunt ", "ut ", "labore ", "et ", "dolore ", "magna."]

// TweenSequence's rainbow, equal weights (misc/tween_sequence.dart).
let an_rainbow = [argb(255,244,67,54), argb(255,255,152,0), argb(255,255,235,59),
                  argb(255,76,175,80), argb(255,33,150,243), argb(255,63,81,181),
                  argb(255,156,39,176)]

fn an_stage(key) {
    // --- Basics ---------------------------------------------------------
    // AnimatedContainer, 400ms: size, colour and corner together.
    if key == "animated_container" {
        let t = ease(pingpong(0.8))
        return [
            {t: "column", w: lerp(72.0, 160.0, t), h: lerp(72.0, 160.0, t),
             radius: lerp(8.0, 60.0, t), bg: lerp_argb(m_pri_cont, m_ter_cont, t)},
            an_caption("size, colour and corner tweened together (400ms)"),
        ]
    }
    // PageRouteBuilder: Tween<Offset> from (0,1) to zero with Curves.ease —
    // a page sliding up over the one below.
    if key == "page_route" {
        let t = ease(pingpong(2.0))
        return [
            {t: "column", fillw: 1, h: 200, radius: 12, bg: m_surf_highest,
             pady: lerp(150.0, 0.0, t), c: [
                {t: "column", fillw: 1, h: 200, radius: 12, bg: m_pri_cont,
                 alignx: 0.5, aligny: 0.5,
                 c: [ txt("Page 2", 16, 500, m_on_pri_cont) ]},
            ]},
            an_caption("Offset(0,1) -> Offset.zero, Curves.ease"),
        ]
    }
    // AnimationController, 1s: the raw 0..1 value.
    if key == "controller" {
        let t = pingpong(1.0)
        return [ an_bar(t), an_caption("controller.value " + roundn(t, 2)) ]
    }
    // Tweens, 1s: Tween(begin: 0, end: 1000000) counting up.
    if key == "tweens" {
        let t = pingpong(1.0)
        return [
            txt("$" + floorn(lerp(0.0, 1000000.0, t)), 34, 500, m_primary),
            an_bar(t),
            an_caption("Tween(begin: 0.0, end: 1000000)"),
        ]
    }
    // AnimatedBuilder, 800ms: ColorTween deepPurple -> deepOrange.
    if key == "animated_builder" {
        let t = pingpong(1.6)
        let deep_purple = argb(255, 103, 58, 183)
        let deep_orange = argb(255, 255, 87, 34)
        return [
            {t: "column", w: 120, h: 120, radius: 12,
             bg: lerp_argb(deep_purple, deep_orange, t)},
            an_caption("ColorTween(deepPurple -> deepOrange), 800ms"),
        ]
    }
    // Custom Tween, 3s: a TypewriterTween over a String.
    if key == "custom_tween" {
        let t = pingpong(3.0)
        let n = floorn(t * 18.0)
        let out = ""
        let i = 0
        for w in an_typed { if i < n { out = out + w }  i = i + 1 }
        return [
            {t: "column", fillw: 1, h: 96, c: [ para(out, 16, 400, m_on_surface) ]},
            an_caption("TypewriterTween — Tween<String>.lerp"),
        ]
    }
    // TweenSequence, 3s: through the seven colours at equal weight.
    if key == "tween_sequence" {
        let t = phase(3.0)
        let seg = floorn(t * 7.0)
        let f = t * 7.0 - seg
        let a = an_rainbow[seg % 7]
        let b = an_rainbow[(seg + 1) % 7]
        return [
            {t: "column", w: 140, h: 140, radius: 70, bg: lerp_argb(a, b, f)},
            an_caption("seven weighted items, 3s"),
        ]
    }
    // FadeTransition, 500ms, Curves.easeIn: opacity 1 -> 0.
    if key == "fade_transition" {
        let t = ease_in_cubic(pingpong(1.0))
        let o = 1.0 - t
        return [
            {t: "column", w: 120, h: 120, radius: 12, bg: fade(m_primary, o)},
            an_caption("opacity " + roundn(o, 2) + ", Curves.easeIn"),
        ]
    }

    // --- Misc -----------------------------------------------------------
    // Expandable card, 300ms, Curves.easeInOutCubic.
    if key == "expand_card" {
        let t = pingpong(1.2)
        let e = 0.0
        if t < 0.5 { e = ease_in_cubic(t * 2.0) / 2.0 }
        else { e = 0.5 + ease_out_cubic((t - 0.5) * 2.0) / 2.0 }
        return [
            {t: "column", w: lerp(140.0, 320.0, e), h: lerp(90.0, 220.0, e),
             radius: 12, bg: m_surf_highest, pad: 12,
             c: [ txt("Card", 14, 500, m_on_surface) ]},
            an_caption("Curves.easeInOutCubic, 300ms"),
        ]
    }
    // Carousel: the centre item scaled up, the neighbours down, easeOut.
    if key == "carousel" {
        let t = pingpong(2.4)
        let cells = []
        let i = 0
        while i < 3 {
            let d = i - 1.0
            let near = 1.0 - absn(d - (t - 0.5) * 2.0) / 2.0
            if near < 0.0 { near = 0.0 }
            let sz = lerp(64.0, 132.0, ease_out_cubic(near))
            cells.push({t: "column", w: sz, h: sz, radius: 10,
                        bg: fade(m_pri_cont, 0.35 + near * 0.65)})
            i = i + 1
        }
        return [
            {t: "row", fillw: 1, spacing: 8, aligny: 0.5, alignx: 0.5, c: cells},
            an_caption("centre item scaled, Curves.easeOut"),
        ]
    }
    // Focus image: RelativeRect -> fill under a long press, Curves.ease.
    if key == "focus_image" {
        let t = ease(pingpong(2.0))
        return [
            {t: "column", fillw: 1, h: 220, bg: m_surf_highest, radius: 12,
             pad: lerp(56.0, 0.0, t), c: [
                {t: "column", fillw: 1, fillh: 1, radius: lerp(10.0, 0.0, t),
                 bg: m_ter_cont, alignx: 0.5, aligny: 0.5,
                 c: [ icon(ic_image, 26, m_on_ter_cont) ]},
            ]},
            an_caption("RelativeRect -> RelativeRect.fill, Curves.ease"),
        ]
    }
    // Card swipe: the card leaves to the right, then springs back.
    if key == "card_swipe" {
        let p = phase(2.6)
        let off = 0.0
        let o = 1.0
        if p < 0.6 { off = ease_in_cubic(p / 0.6) * 260.0  o = 1.0 - p / 0.6 }
        else { off = 0.0  o = 1.0 }
        return [
            {t: "row", fillw: 1, h: 150, padx: off, c: [
                {t: "column", fillw: 1, fillh: 1, radius: 12,
                 bg: fade(m_pri_cont, o)},
            ]},
            an_caption("dismiss to Offset(1,0), then spring back"),
        ]
    }
    // flutter_animate: a staggered chain — fade, then slide, then scale.
    if key == "flutter_animate" {
        let p = phase(3.0)
        let f = clamp01(p / 0.33)
        let sl = clamp01((p - 0.33) / 0.33)
        let sc = clamp01((p - 0.66) / 0.34)
        let d = lerp(90.0, 140.0, ease_out_cubic(sc))
        return [
            {t: "row", fillw: 1, h: 150, padx: lerp(0.0, 120.0, ease(sl)),
             aligny: 0.5, c: [
                {t: "column", w: d, h: d, radius: 12,
                 bg: fade(m_primary, f)},
            ]},
            an_caption("fade -> slide -> scale, chained"),
        ]
    }
    // Repeating animation, 2s: BorderRadius 100 -> 0.
    if key == "repeating" {
        let t = pingpong(2.0)
        return [
            {t: "column", w: 140, h: 140, radius: lerp(100.0, 0.0, t),
             bg: m_primary},
            an_caption("BorderRadius 100 -> 0, repeat(reverse: true)"),
        ]
    }
    // Spring physics: released off-centre, oscillating back.
    if key == "spring" {
        let p = phase(2.4)
        let x = (1.0 - spring(p)) * 150.0
        return [
            {t: "row", fillw: 1, h: 150, padx: absn(x), aligny: 0.5, c: [
                {t: "column", w: 90, h: 90, radius: 12, bg: m_ter_cont},
            ]},
            an_caption("SpringDescription, settling on centre"),
        ]
    }
    // AnimatedList, 300ms in / 600ms out.
    if key == "animated_list" {
        let n = 2 + floorn(pingpong(3.0) * 3.0)
        let rows = []
        let i = 0
        while i < n {
            rows.push({t: "row", fillw: 1, h: 40, bg: m_surf_highest, radius: 8,
                       padx: 12, aligny: 0.5,
                       c: [ txt("Item " + i, 14, 400, m_on_surface) ]})
            i = i + 1
        }
        return [ {t: "column", fillw: 1, spacing: 8, c: rows},
                 an_caption("insert 300ms / remove 600ms") ]
    }
    // AnimatedPositioned, 1s: between two corners of the stack.
    if key == "animated_positioned" {
        let t = ease(pingpong(1.0))
        return [
            {t: "column", fillw: 1, h: 190, bg: m_surf_highest, radius: 12,
             pady: lerp(8.0, 110.0, t), padx: lerp(8.0, 210.0, t), c: [
                {t: "column", w: 70, h: 70, radius: 10, bg: m_primary},
            ]},
            an_caption("Positioned tweened inside a Stack, 1s"),
        ]
    }
    // AnimatedSwitcher, 1s: one child scales out as the next scales in.
    if key == "animated_switcher" {
        let p = phase(2.0)
        let first = p < 0.5
        let local = p * 2.0
        if !first { local = (p - 0.5) * 2.0 }
        let sc = 0.0
        if local < 0.5 { sc = 1.0 - local * 2.0 } else { sc = (local - 0.5) * 2.0 }
        let d = lerp(40.0, 130.0, sc)
        let col = pick_if(first, m_pri_cont, m_ter_cont)
        let ink = pick_if(first, m_on_pri_cont, m_on_ter_cont)
        return [
            {t: "column", fillw: 1, h: 150, alignx: 0.5, aligny: 0.5, c: [
                {t: "column", w: d, h: d, radius: 12, bg: col, alignx: 0.5,
                 aligny: 0.5, c: [ txt(pick_if(first, "1", "2"), 22, 500, ink) ]},
            ]},
            an_caption("ScaleTransition between children, 1s"),
        ]
    }
    // Hero: the thumbnail flies and grows into the detail image.
    if key == "hero" {
        let t = ease(pingpong(2.0))
        let d = lerp(50.0, 200.0, t)
        return [
            {t: "row", fillw: 1, h: 220, padx: lerp(0.0, 60.0, t), aligny: 0.5, c: [
                {t: "column", w: d, h: d, radius: lerp(25.0, 12.0, t),
                 bg: m_pri_cont, alignx: 0.5, aligny: 0.5,
                 c: [ icon(ic_image, lerp(16.0, 40.0, t), m_on_pri_cont) ]},
            ]},
            an_caption("Hero flight, 50 -> 200"),
        ]
    }
    // CurvedAnimation, 4s: the same ramp under six named curves.
    if key == "curved" {
        let t = pingpong(4.0)
        return [
            an_curve_row("linear", t),
            an_curve_row("easeInCubic", ease_in_cubic(t)),
            an_curve_row("easeOutCubic", ease_out_cubic(t)),
            an_curve_row("easeInExpo", ease_in_expo(t)),
            an_curve_row("easeOutExpo", ease_out_expo(t)),
            an_curve_row("bounceOut", bounce_out(t)),
        ]
    }

    // The two makepad widgets that animate in their own shader.
    return [
        {t: "row", spacing: 24, fitw: 1, aligny: 0.5, c: [
            {t: "loading", w: 48, h: 48, bg: m_primary},
            {t: "progress", w: 48, h: 48, bg: m_primary},
        ]},
        an_caption("makepad's own shader drives these off draw time"),
    ]
}

fn an_curve_row(name, v) {
    return {t: "column", fillw: 1, spacing: 4, c: [
        txt(name, 12, 500, m_on_surf_var),
        an_bar(clamp01(v)),
    ]}
}

fn clamp01(x) {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

fn an_bar(t) {
    return {t: "column", fillw: 1, h: 8, radius: 4, bg: m_sec_cont, c: [
        {t: "column", w: lerp(4.0, 300.0, t), h: 8, radius: 4, bg: m_primary},
    ]}
}

fn an_caption(s) {
    return {t: "column", fillw: 1, alignx: 0.5,
            c: [ para(s, 13, 400, m_on_surf_var) ]}
}

fn roundn(x, places) {
    let m = 1.0
    let i = 0
    while i < places { m = m * 10.0; i = i + 1 }
    return floorn(x * m + 0.5) / m
}

// ---- asset_transformation.splash
// asset_transformation — flutter/samples/asset_transformation
//
// Previously "no analogue", on the grounds that Flutter's asset transformation
// is a build-system feature — a Dart package named in pubspec.yaml rewrites an
// asset as it is bundled — and Cargo has no asset pipeline.
//
// The first half is right and the conclusion still does not follow. Splash-OH
// serves its frontend over a custom `splash://` scheme, and `assets::get(url)`
// is the resolver: a request URL in, a mime type, a status and bytes out, with
// one asset (`__splash.js`) *generated* rather than shipped. That is a request-
// time asset pipeline, which is the same idea one stage later than Flutter's.
//
// The rows below are live: each is a real resolve performed when this screen
// mounted.

fn at_row(label, answer) {
    return {t: "column", fillw: 1, fith: 1, bg: m_surf_lowest, radius: 8,
            pad: 12, spacing: 4, c: [
        txt(label, 13, 500, m_primary),
        para(answer, 12, 400, m_on_surf_var),
    ]}
}

fn screen_asset_transformation() {
    return page(m_surface, [
        m_appbar("Asset Transformation", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("splash:// resolves a request to bytes", [
                at_row("a generated asset", invoke("assets.shim")),
                at_row("a shipped asset", invoke("assets.index")),
                at_row("a miss", invoke("assets.missing")),
            ]),
            m_section("Where this differs from Flutter", [
                para("Flutter transforms at bundle time: the asset on disk is "
                     + "rewritten before it ships. This transforms at request "
                     + "time — the resolver decides what the bytes are when the "
                     + "page asks for them, which is why __splash.js can be "
                     + "generated rather than stored.",
                     13, 400, m_on_surf_var),
                para("A miss answers 404 rather than declining. ArkWeb has no "
                     + "default resolver for a custom scheme, so an unhandled "
                     + "request is not a miss — it is a hang.",
                     13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

// ---- background_isolate_channels.splash
// background_isolate_channels — flutter/samples/background_isolate_channels
//
// Previously "no analogue", on the grounds that the sample exists because
// Flutter's platform channels are bound to the root isolate, a constraint with
// no counterpart here.
//
// That is still true, and it made the wrong point. What the sample is really
// about is doing platform work without blocking the UI, and this stack has the
// same problem and a real answer to it — Splash-OH moved its sensor work off
// the service's thread for exactly this reason.

fn screen_background_isolate_channels() {
    return page(m_surface, [
        m_appbar("Background Work", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("A platform call that waits, without blocking", [
                {t: "column", fillw: 1, bg: m_surf_lowest, radius: 8, pad: 12,
                 spacing: 4, c: [
                    txt("thread.offmain", 13, 500, m_primary),
                    para(invoke("thread.offmain"), 12, 400, m_on_surf_var),
                ]},
                para("A sensor sample with a 250ms timeout. `blocked_ui_ms` is "
                     + "how long this thread actually waited: the sampling runs "
                     + "on the sensor service's own thread and the answer is "
                     + "handed back, rather than the UI thread sitting on it.",
                     13, 400, m_on_surf_var),
            ]),
            m_section("Why the sample's constraint does not exist here", [
                para("Flutter binds platform channels to the root isolate, so "
                     + "calling a plugin from a background isolate needs a "
                     + "RootIsolateToken and BackgroundIsolateBinaryMessenger. "
                     + "Rust threads have no such affinity — any thread can call "
                     + "a capability.", 13, 400, m_on_surf_var),
                para("The problem that remains is the ordinary one: not doing "
                     + "slow work where the frame is drawn.",
                     13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

// ---- compass_app.splash
// compass_app — flutter/samples/compass_app
//
// The largest sample: a travel-planning app that exists to demonstrate the
// Flutter *architecture* guidelines — MVVM, repositories, use-cases, DI via
// provider, a command pattern, an offline-first local store, fake vs remote
// data sources, and a Dart server. Roughly 9k lines across app/ and server/.
//
// The five screens port: Home, Search form, Results, Activities, Booking. The
// destinations and activities below are the real assets/destinations.json and
// assets/activities.json entries.
//
// The architecture does not port, and that is most of the sample. There is no
// view-model layer to bind to, no repository, no command, no persistence — the
// pipeline evaluates data to a tree once per mount. What is here is the app's
// surface, not its structure.
//
// One thing here is not a mock. A travel planner on a phone can know where the
// phone is, and this one asks: `location.enabled` reads the system switch and
// `location.fix` returns the cached position. Splash-OH has had a location
// stack all along — `location::get`, `nearest_city`, the permissions declared
// in module.json5 — but only web pages could reach it; no DSL screen could, so
// this screen was entirely static while the capability sat there unused.
//
// `location.fix` never blocks. A real request takes seconds and this runs while
// the tree is being built, so the worker refreshes a cache and the screen shows
// "locating" until a mount lands after the fix does.

// name, country, continent, tags
let ca_dest = [
    ["Alaska", "United States", "North America", "Mountain · Wildlife watching"],
    ["Amalfi Coast", "Italy", "Europe", "Beach · Romantic · Foodie"],
    ["Amazon Rainforest", "Brazil", "South America", "Jungle · Adventure sports"],
    ["The Andes Mountains", "South America", "South America", "Mountain · Hiking"],
    ["Angkor Wat", "Cambodia", "Asia", "Historic · Sightseeing"],
    ["Antelope Canyon", "United States", "North America", "Hiking · Sightseeing"],
    ["Aruba", "Aruba", "South America", "Beach · Island · Scuba diving"],
    ["Asheville", "USA", "North America", "City · Hiking · Cultural"],
]

let ca_continents = ["Africa", "Asia", "Australia", "Europe",
                     "North America", "Oceania", "South America"]

// name, time of day
let ca_activities = [
    ["Glacier Trekking and Ice Climbing", "morning"],
    ["Dog Sledding Experience", "morning"],
    ["Hiking in Denali National Park", "any"],
    ["Wildlife Viewing Cruise", "any"],
]

// Where the phone is, from the platform. Not part of the Flutter sample — the
// sample has no location — but it is the one thing this screen can say that a
// mock cannot, and the capability was already here.
fn ca_here() {
    // The host answers with a line to show and a state to branch on. The VM has
    // no JSON and no substring test, so anything this screen decides on has to
    // arrive as a value `==` can compare.
    let state = invoke("location.state")
    let got = state == "ok"
    let tint = pick_if(got, m_pri_cont, m_surf_highest)
    let ink = pick_if(got, m_on_pri_cont, m_on_surf_var)
    return {t: "row", fillw: 1, radius: 12, bg: tint, padx: 14, pady: 12,
            spacing: 10, aligny: 0.5, c: [
        icon(ic_pin, 14, ink),
        {t: "column", fillw: 1, fith: 1, spacing: 2, c: [
            txt("Where you are", 13, 500, ink),
            para(invoke("location.fix"), 11, 400, ink),
            para("system switch: " + invoke("location.enabled"), 11, 400, ink),
        ]},
    ]}
}

fn screen_compass_app() {
    let cards = []
    let i = 0
    for d in ca_dest {
        if i < 4 {
            cards.push(ca_card(d[0], d[1], d[3]))
        }
        i = i + 1
    }
    return page(m_surface, [
        m_appbar("Compass", "index"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            {t: "column", fillw: 1, spacing: 4, c: [
                txt("Let's explore", 32, 400, m_on_surface),
                txt("Where would you like to go?", 16, 400, m_on_surf_var),
            ]},
            {t: "row", fillw: 1, h: 56, radius: 28, bg: m_surf_highest, padx: 20,
             spacing: 10, aligny: 0.5, tapto: "compass_app/search", c: [
                icon(ic_search, 15, m_on_surf_var),
                txt("Search destinations", 16, 400, m_on_surf_var),
            ]},
            ca_here(),
            m_section("Your bookings", cards),
            m_section("What is real here and what is not", [
                para("The destinations, activities and bookings are the "
                     + "sample's own assets/destinations.json and "
                     + "activities.json, drawn accurately and wired to nothing: "
                     + "search does not search, the stepper does not step, and "
                     + "a booking cannot be made.", 13, 400, m_on_surf_var),
                para("The position above is real, read from the platform. It is "
                     + "not part of the Flutter sample — that app has no "
                     + "location — but Splash-OH's location stack was sitting "
                     + "unused because no DSL screen could reach it.",
                     13, 400, m_on_surf_var),
                para("The architecture the sample exists to demonstrate — MVVM, "
                     + "repositories, commands, an offline store — is still "
                     + "absent. A tree evaluated once per mount has nowhere to "
                     + "put a view model.", 13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

fn ca_card(name, country, tags) {
    return {t: "column", fillw: 1, radius: 12, bg: m_surf_lowest, elevation: 1,
            c: [
        {t: "column", fillw: 1, h: 120, radius: 12, bg: m_pri_cont,
         alignx: 0.5, aligny: 0.5, c: [ icon(ic_pin, 26, m_on_pri_cont) ]},
        {t: "column", fillw: 1, pad: 12, spacing: 4, c: [
            txt(name, 16, 500, m_on_surface),
            txt(country, 13, 400, m_on_surf_var),
            txt(tags, 12, 400, m_on_surf_var),
        ]},
    ]}
}

fn screen_compass_app_search() {
    let chips = []
    for c in ca_continents { chips.push(m_chip(c, c == "Europe")) }
    return page(m_surface, [
        m_appbar("Search", "compass_app"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("Where to?", chips),
            m_section("When", [
                {t: "row", fillw: 1, h: 56, radius: 8, bg: m_surf_highest,
                 padx: 16, spacing: 10, aligny: 0.5, c: [
                    icon(ic_cal, 14, m_on_surf_var),
                    txt("Jan 1 — Jan 8", 16, 400, m_on_surface),
                ]},
            ]),
            m_section("Guests", [
                {t: "row", fillw: 1, h: 56, spacing: 16, aligny: 0.5, c: [
                    txt("Guests", 16, 400, m_on_surface),
                    spacer(),
                    ca_stepper("2"),
                ]},
            ]),
            m_btn("Search", m_primary, m_on_primary),
        ]},
    ])
}

fn ca_stepper(value) {
    return {t: "row", fitw: 1, spacing: 16, aligny: 0.5, c: [
        {t: "column", w: 36, h: 36, radius: 18, bg: m_surf_highest,
         alignx: 0.5, aligny: 0.5, c: [ txt("−", 18, 500, m_on_surface) ]},
        txt(value, 16, 500, m_on_surface),
        {t: "column", w: 36, h: 36, radius: 18, bg: m_surf_highest,
         alignx: 0.5, aligny: 0.5, c: [ txt("+", 18, 500, m_on_surface) ]},
    ]}
}

fn screen_compass_app_results() {
    let cards = []
    for d in ca_dest { cards.push(ca_result_row(d[0], d[1], d[3])) }
    return page(m_surface, [
        m_appbar("Results", "compass_app/search"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 12, c: cards},
    ])
}

fn ca_result_row(name, country, tags) {
    return {t: "row", fillw: 1, fith: 1, radius: 12, bg: m_surf_low, spacing: 12,
            tapto: "compass_app/activities", c: [
        {t: "column", w: 96, h: 96, radius: 12, bg: m_ter_cont,
         alignx: 0.5, aligny: 0.5, c: [ icon(ic_pin, 20, m_on_ter_cont) ]},
        {t: "column", fillw: 1, fith: 1, padx: 4, pady: 12, spacing: 4, c: [
            txt(name, 16, 500, m_on_surface),
            txt(country, 13, 400, m_on_surf_var),
            para(tags, 12, 400, m_on_surf_var),
        ]},
    ]}
}

fn screen_compass_app_activities() {
    let morning = []
    let anytime = []
    for a in ca_activities {
        let row = {t: "row", fillw: 1, fith: 1, pady: 10, spacing: 12,
                   aligny: 0.5, c: [
            {t: "checkbox", on: 0, w: 18, h: 18},
            {t: "column", fillw: 1, fith: 1, c: [ para(a[0], 15, 400, m_on_surface) ]},
        ]}
        if a[1] == "morning" { morning.push(row) } else { anytime.push(row) }
    }
    return page(m_surface, [
        m_appbar("Activities", "compass_app/results"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("Morning", morning),
            m_section("Any time", anytime),
        ]},
        {t: "row", fillw: 1, padx: 16, pady: 12, bg: m_surf_cont, c: [
            {t: "column", fillw: 1, tapto: "compass_app/booking",
             c: [ m_btn_wide("Confirm", m_primary, m_on_primary) ]},
        ]},
    ])
}

fn screen_compass_app_booking() {
    return page(m_surface, [
        m_appbar("Booking", "compass_app/activities"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            {t: "column", fillw: 1, h: 160, radius: 12, bg: m_pri_cont,
             alignx: 0.5, aligny: 0.5, c: [ icon(ic_compass, 40, m_on_pri_cont) ]},
            {t: "column", fillw: 1, spacing: 4, c: [
                txt("Alaska, United States", 24, 400, m_on_surface),
                txt("Jan 1 — Jan 8 · 2 guests", 14, 400, m_on_surf_var),
            ]},
            m_section("Itinerary", [
                txt("Glacier Trekking and Ice Climbing", 14, 400, m_on_surface),
                txt("Dog Sledding Experience", 14, 400, m_on_surface),
                txt("Hiking in Denali National Park", 14, 400, m_on_surface),
            ]),
            m_btn_wide("Share", m_primary, m_on_primary),
        ]},
    ])
}


// ---- cupertino_gallery.splash
// cupertino_gallery — flutter/samples/cupertino_gallery
//
// A CupertinoTabScaffold with two tabs (Widgets, Settings). The Widgets tab is
// a CupertinoSliverNavigationBar large title over 21 list rows, each pushing a
// WidgetDetailPage.
//
// Every detail page below is transcribed from its own source in
// `cupertino_gallery/lib/widgets/*.dart` — the same labels, the same controls,
// the same initial values (`switch_page.dart` starts ON, `checkbox_page.dart`
// OFF, `slider_page.dart` at 0.5, `picker_page.dart` shows One/Two/Three).
// An earlier version of this file invented its own content for these pages,
// which is why the gallery read as barely implemented.
//
// Geometry is Flutter's, from the framework source rather than the spec:
// CupertinoButton large is minSize 44 / padding v16 h20 / radius 12
// (cupertino/constants.dart:64-86); CupertinoTextField radius 9
// (text_field.dart:369); the activity indicator is radius 10
// (activity_indicator.dart:12); the tab bar is 50 (bottom_tab_bar.dart:19);
// segmented controls are 28 tall (segmented_control.dart:22).

let cg_widgets = [
    ["Action Sheet", "action_sheet"], ["Activity Indicator", "activity"],
    ["Alert Dialog", "alert"], ["Button", "button"], ["Checkbox", "checkbox"],
    ["Context Menu", "context_menu"], ["Date Picker", "date_picker"],
    ["List Tile", "list_tile"], ["Picker", "picker"],
    ["Popup Surface", "popup"], ["Radio", "radio"], ["Scrollbar", "scrollbar"],
    ["Search Text Field", "search"], ["Segmented Control", "segmented"],
    ["Sheet", "sheet"], ["Slider", "slider"],
    ["Sliding Segmented Control", "sliding"], ["Switch", "switch"],
    ["Text Field", "text_field"], ["Text Theme", "text_theme"],
    ["Time Picker", "time_picker"],
]

fn cg_tabbar(active) {
    let items = [
        ["Widgets", ic_list, "cupertino_gallery"],
        ["Settings", ic_gear, "cupertino_gallery/settings"],
    ]
    let cells = []
    for it in items {
        let ink = pick_if(it[0] == active, c_blue, c_label2)
        cells.push({t: "column", fillw: 1, h: 50, spacing: 2, alignx: 0.5, aligny: 0.5,
                    tapto: it[2], c: [ icon(it[1], 18, ink), txt(it[0], 10, 400, ink) ]})
    }
    return {t: "column", fillw: 1, bg: c_grouped, c: [
        rule(c_separator),
        {t: "row", fillw: 1, h: 50, c: cells},
    ]}
}

fn screen_cupertino_gallery() {
    let rows = []
    for w in cg_widgets {
        // CustomCupertinoListTile: 16 horizontal / 12 vertical padding, a
        // trailing forward chevron and a bottom separator (widgets_page.dart).
        rows.push({t: "column", fillw: 1, c: [
            {t: "row", fillw: 1, fith: 1, padx: 16, pady: 12,
             tapto: "cupertino_gallery/" + w[1], c: [
                txt(w[0], 17, 400, c_label),
                spacer(),
                icon(ic_fwd, 13, c_label2),
            ]},
            rule(c_separator),
        ]})
    }
    return page(c_bg, [
        {t: "row", bg: c_grouped, fillw: 1, h: 44, padx: 16, aligny: 0.5, c: [
            {t: "row", fitw: 1, h: 44, padx: 4, spacing: 4, aligny: 0.5,
             tapto: "index", c: [
                icon(ic_back, 15, c_blue), txt("Samples", 17, 400, c_blue),
            ]},
        ]},
        c_largetitle("Cupertino Gallery"),
        {t: "scroll", fillw: 1, bg: c_grouped, c: rows},
        cg_tabbar("Widgets"),
    ])
}

fn screen_cupertino_gallery_settings() {
    return page(c_bg, [
        c_largetitle("Settings"),
        {t: "scroll", fillw: 1, padx: 16, c: [
            c_group("APPEARANCE", [
                {t: "row", fillw: 1, h: 44, padx: 16, spacing: 8, aligny: 0.5, c: [
                    txt("Dark Mode", 17, 400, c_label), spacer(),
                    {t: "toggle", on: dk, w: 51, h: 31},
                ]},
            ]),
            c_group("TEXT SIZE", [
                {t: "column", fillw: 1, padx: 16, pady: 12, spacing: 8, c: [
                    {t: "slider", value: 0.5, fillw: 1, h: 28},
                    {t: "row", fillw: 1, c: [
                        txt("A", 13, 400, c_label2), spacer(), txt("A", 22, 400, c_label2),
                    ]},
                ]},
            ]),
        ]},
        cg_tabbar("Settings"),
    ])
}

// ---- the WidgetDetailPage shell ---------------------------------------------
// Each page is a CupertinoPageScaffold: a nav bar over a centred child.

fn cg_detail(title, body_kids) {
    return page(c_bg, [
        c_navbar(title, "cupertino_gallery"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, alignx: 0.5, c: body_kids},
    ])
}

fn cg_note(s) {
    return {t: "column", fillw: 1, padx: 4, c: [ para(s, 13, 400, c_label2) ]}
}

// CupertinoButton, large size style. `.filled` paints activeBlue; plain draws
// the label in activeBlue on nothing; disabled drops to the inactive grey.
fn cg_button(label, filled, enabled) {
    let ink = pick_if(enabled == 1, pick_if(filled == 1, white, c_blue), c_label2)
    let fill = pick_if(filled == 1, pick_if(enabled == 1, c_blue, c_fill), clear)
    return {t: "column", bg: fill, radius: 12, h: 44, padx: 20, fitw: 1,
            alignx: 0.5, aligny: 0.5, c: [ txt(label, 17, 400, ink) ]}
}

// button_page.dart: two labelled groups, each Enabled then Disabled.
fn screen_cg_button() {
    return cg_detail("Button", [
        txt("CupertinoButton widget", 17, 400, c_label),
        cg_button("Enabled", 0, 1),
        cg_button("Disabled", 0, 0),
        gap(16),
        txt("CupertinoButton.filled widget", 17, 400, c_label),
        cg_button("Enabled", 1, 1),
        cg_button("Disabled", 1, 0),
    ])
}

// switch_page.dart holds one CupertinoSwitch, initially ON. Track 51x31 with a
// 28 thumb (cupertino/switch.dart:29-31).
fn screen_cg_switch() {
    return cg_detail("Switch", [ {t: "toggle", on: 1, w: 51, h: 31} ])
}

// checkbox_page.dart: one CupertinoCheckbox, initially OFF.
fn screen_cg_checkbox() {
    return cg_detail("Checkbox", [ {t: "checkbox", on: 0, w: 18, h: 18} ])
}

// slider_page.dart: one CupertinoSlider at 0.5.
fn screen_cg_slider() {
    return cg_detail("Slider", [ {t: "slider", value: 0.5, fillw: 1, h: 30} ])
}

// radio_page.dart: three CupertinoListTiles, each with a leading CupertinoRadio,
// in a RadioGroup with the first selected.
fn screen_cg_radio() {
    let rows = []
    let labels = ["Option 1", "Option 2", "Option 3"]
    let i = 0
    for l in labels {
        if i > 0 { rows.push(rule(c_separator)) }
        rows.push({t: "row", fillw: 1, h: 44, padx: 16, spacing: 12, aligny: 0.5, c: [
            {t: "radio", on: pick_if(i == 0, 1, 0), w: 16, h: 16},
            txt(l, 17, 400, c_label),
        ]})
        i = i + 1
    }
    return cg_detail("Radio", [
        {t: "column", fillw: 1, bg: c_grouped, radius: 10, c: rows},
    ])
}

// activity_indicator_page.dart: one centred CupertinoActivityIndicator.
fn screen_cg_activity() {
    return cg_detail("Activity Indicator", [ {t: "loading", w: 20, h: 20, bg: c_label2} ])
}

// alert_dialog_page.dart: a button showing an alert titled "Alert" with
// "This is a sample alert dialog." and OK / NO.
fn screen_cg_alert() {
    return cg_detail("Alert Dialog", [
        cg_button("Show Alert Dialog", 0, 1),
        {t: "column", bg: c_grouped, radius: 14, w: 270, alignx: 0.5, c: [
            {t: "column", fillw: 1, pad: 20, spacing: 4, alignx: 0.5, c: [
                txt("Alert", 17, 500, c_label),
                para("This is a sample alert dialog.", 13, 400, c_label),
            ]},
            rule(c_separator),
            {t: "row", fillw: 1, h: 45, c: [
                {t: "column", fillw: 1, fillh: 1, alignx: 0.5, aligny: 0.5,
                 c: [ txt("OK", 17, 400, c_blue) ]},
                {t: "column", w: 1, fillh: 1, bg: c_separator},
                {t: "column", fillw: 1, fillh: 1, alignx: 0.5, aligny: 0.5,
                 c: [ txt("NO", 17, 400, c_blue) ]},
            ]},
        ]},
    ])
}

// action_sheet_page.dart: Title / Message, Action One, Action Two, Cancel.
fn cg_sheet_action(label, weight) {
    return {t: "column", fillw: 1, h: 57, alignx: 0.5, aligny: 0.5,
            c: [ txt(label, 20, weight, c_blue) ]}
}

fn screen_cg_action_sheet() {
    return cg_detail("Action Sheet", [
        cg_button("Show Action Sheet", 0, 1),
        {t: "column", fillw: 1, spacing: 8, c: [
            {t: "column", fillw: 1, bg: c_grouped, radius: 14, c: [
                {t: "column", fillw: 1, pad: 16, spacing: 2, alignx: 0.5, c: [
                    txt("Title", 13, 500, c_label2),
                    txt("Message", 13, 400, c_label2),
                ]},
                rule(c_separator),
                cg_sheet_action("Action One", 400),
                rule(c_separator),
                cg_sheet_action("Action Two", 400),
            ]},
            {t: "column", fillw: 1, bg: c_grouped, radius: 14,
             c: [ cg_sheet_action("Cancel", 500) ]},
        ]},
    ])
}

// list_tile_page.dart: an insetGrouped section then a plain one, three
// Title/Subtitle tiles each, leading icons info/person/wifi then search/heart/ant.
fn cg_tile(glyph) {
    return {t: "row", fillw: 1, fith: 1, padx: 16, pady: 10, spacing: 16,
            aligny: 0.5, c: [
        icon(glyph, 20, c_blue),
        {t: "column", fillw: 1, fith: 1, spacing: 3, c: [
            txt("Title", 17, 400, c_label),
            txt("Subtitle", 12, 400, c_label2),
        ]},
        icon(ic_fwd, 13, c_label2),
    ]}
}

fn cg_tile_section(glyphs) {
    let rows = []
    let first = 1
    for g in glyphs {
        if first == 0 { rows.push(rule(c_separator)) }
        first = 0
        rows.push(cg_tile(g))
    }
    return {t: "column", fillw: 1, bg: c_grouped, radius: 10, c: rows}
}

fn screen_cg_list_tile() {
    return cg_detail("List Tile", [
        cg_tile_section([ic_bolt, ic_user, ic_globe]),
        cg_tile_section([ic_search, ic_heart, ic_leaf]),
    ])
}

// text_field_page.dart: one CupertinoTextField, placeholder "Enter text".
fn screen_cg_text_field() {
    return cg_detail("Text Field", [
        {t: "column", fillw: 1, h: 36, radius: 9, bg: c_grouped, border: 1,
         bordercolor: c_separator, padx: 7, aligny: 0.5,
         c: [ {t: "input", placeholder: "Enter text", fillw: 1, fith: 1} ]},
    ])
}

// search_text_field_page.dart: a bare CupertinoSearchTextField, height 36.
fn screen_cg_search() {
    return cg_detail("Search Text Field", [
        {t: "row", fillw: 1, h: 36, radius: 9, bg: c_fill, padx: 8, spacing: 6,
         aligny: 0.5, c: [
            icon(ic_search, 13, c_label2),
            {t: "input", placeholder: "Search", fillw: 1, fith: 1},
        ]},
    ])
}

// picker_page.dart: CupertinoPicker, itemExtent 32, children One/Two/Three.
fn screen_cg_picker() {
    return cg_detail("Picker", [
        c_wheel([["One", "Two", "Three"]], 1),
        cg_note("makepad has no picker widget, so this wheel is drawn from a "
                + "column of labels with the selection band behind it. It does "
                + "not spin."),
    ])
