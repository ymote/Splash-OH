}

fn screen_form_app_form_widgets() {
    return page(m_surface, [
        m_appbar("Form widgets", "form_app"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
            m_section("Fields", [
                fa_field("Title", "Enter a title..."),
                fa_field("Description", "Enter a description..."),
            ]),
            m_section("Date", [
