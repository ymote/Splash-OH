                fa_field("Username", "Enter your username"),
                fa_field("Password", "Enter your password"),
                m_btn("Sign in", m_primary, m_on_primary),
            ]),
            m_section("Not ported", [
                para("The submit posts to a mock http.Client and swaps the button "
                    + "for a progress indicator while it is in flight. There is no "
                    + "async or HTTP in the render pipeline, so the button is inert.", 13, 400, m_on_surf_var),
            ]),
        ]},
    ])
}

fn screen_form_app_autofill() {
    return page(m_surface, [
        m_appbar("Autofill", "form_app"),
        {t: "scroll", fillw: 1, pad: 16, spacing: 16, c: [
